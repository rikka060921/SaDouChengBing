@page "/DailySummary/Index"
@model ToDo.Razor.Pages.DailySummary.IndexModel
@{
    ViewData["Title"] = Model.CanGenerateForCurrentUser ? "我的日报" : "成员日报明细";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    @{
        ViewData["WorkReportSection"] = Model.CanGenerateForCurrentUser ? "mine" : "team";
        ViewData["CanViewMemberReports"] = Model.IsAnyProjectLeader;
    }
    <partial name="_WorkReportNav" view-data="ViewData" />
    <!-- 顶部筛选栏（单日期查询 + 生成报告按钮） -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold mb-0">📅 @(Model.ViewingUserName)每日工作报告</h2>
            <p class="text-muted mb-0">@Model.SelectDate.ToString("yyyy年MM月dd日")</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <form method="get" asp-page="./Details" target="_blank" rel="noopener" class="d-inline-flex gap-2 align-items-center">
                @if (Model.UserId.HasValue)
                {
                    <input type="hidden" name="userId" value="@Model.UserId" />
                }
                <input type="hidden" name="filterStartDate" value="@Model.FilterStartDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="filterEndDate" value="@Model.FilterEndDate?.ToString("yyyy-MM-dd")" />
                <input type="date" name="selectDate"
                       value="@Model.SelectDate.ToString("yyyy-MM-dd")"
                       class="form-control" style="width:180px;" />
                <button type="submit" class="btn btn-primary px-4" title="在新标签页查看日报">查询</button>
                <a asp-page="./Details" target="_blank" rel="noopener" asp-route-selectDate="@AppTime.Today.ToString("yyyy-MM-dd")"
                   asp-route-userId="@Model.UserId"
                   asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                   asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-outline-secondary px-4">今日</a>
                @if (Model.CanGenerateForCurrentUser)
                {
                    <a asp-page="Generate" class="btn btn-success px-4" id="generateSummaryButton">根据工作记录生成</a>
                    <a asp-page="Write" asp-route-reportDate="@Model.SelectDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">手动填写／补录</a>
                }
            </form>
            <div id="generateSummaryProgress" class="ai-generation-status d-none mt-3 ms-auto" aria-live="polite"></div>
        </div>
    </div>

    @if (Model.CanGenerateForCurrentUser)
    {
        <p class="small text-muted">日报复用已有工作记录，不必再抄写一遍。请先在 <a asp-page="/ActionCenter/Index">待我处理</a> 更新真实进展，生成后核对参与归因：任务由他人更新不等于本人完成。</p>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 历史报告筛选栏 -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="d-flex flex-wrap gap-3 align-items-center">
                @if (Model.UserId.HasValue)
                {
                    <input type="hidden" name="userId" value="@Model.UserId" />
                }
                <label class="form-label mb-0 fw-semibold">开始日期：</label>
                <input type="date" name="filterStartDate"
                       value="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                       class="form-control" style="width:180px;" />
                <label class="form-label mb-0 fw-semibold">结束日期：</label>
                <input type="date" name="filterEndDate"
                       value="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                       class="form-control" style="width:180px;" />
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-funnel me-1"></i>筛选
                </button>
                <a asp-page="./Index"
                   asp-route-userId="@Model.UserId"
                   class="btn btn-secondary px-4">重置</a>
            </form>
        </div>
    </div>

    <!-- 历史日报列表 -->
    @if (Model.SummaryHistoryList != null && Model.SummaryHistoryList.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-ul me-2 text-primary"></i>
                    📋 历史日报列表（@Model.SummaryHistoryList.Count 条，按日期倒序）
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color:#007bff; color:white;">
                        <tr>
                            <th style="width:140px;">报告日期</th>
                            <th>报告标题</th>
                            <th style="width:120px;">生成方式</th>
                            <th style="width:160px;">生成时间</th>
                            <th>内容预览</th>
                            <th style="width:100px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SummaryHistoryList)
                        {
                            var isCurrent = item.SummaryDate.Date == Model.SelectDate.Date;
                            <tr style="@(isCurrent ? "background-color:#e8f0fe;" : null)">
                                <td class="fw-semibold">
                                    @if (isCurrent)
                                    {
                                        <span class="badge bg-primary me-1">当前</span>
                                    }
                                    <a asp-page="./Details" target="_blank" rel="noopener"
                                       asp-route-selectDate="@item.SummaryDate.ToString("yyyy-MM-dd")"
                                       asp-route-userId="@Model.UserId"
                                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                                       style="color: @(isCurrent ? "#007bff" : "#212529");">
                                        @item.SummaryDate.ToString("yyyy-MM-dd")
                                    </a>
                                </td>
                                <td>
                                    <a asp-page="./Details" target="_blank" rel="noopener"
                                       asp-route-selectDate="@item.SummaryDate.ToString("yyyy-MM-dd")"
                                       asp-route-userId="@Model.UserId"
                                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                                       class="text-decoration-none"
                                       style="color: @(isCurrent ? "#007bff" : "#212529");">
                                        @item.Title
                                    </a>
                                </td>
                                <td>
                                    @if (item.Id < 0)
                                    {
                                        <span class="badge bg-secondary">项目日报</span>
                                    }
                                    else if (item.Id == 0)
                                    {
                                        <span class="badge bg-warning text-dark">人工填写</span>
                                    }
                                    else if (item.IsAutomatic)
                                    {
                                        <span class="badge bg-primary">定时触发 AI</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">手动触发 AI</span>
                                    }
                                    @if (item.Id > 0 && Model.ManualDates.Contains(item.SummaryDate.Date)) { <span class="badge bg-warning text-dark">含人工校订</span> }
                                </td>
                                <td class="text-muted small">@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small text-muted" title="@item.TotalSummary">
                                    @if (!string.IsNullOrEmpty(item.TotalSummary) && item.TotalSummary.Length > 60)
                                    {
                                        @item.TotalSummary.Substring(0, 60)<text>…</text>
                                    }
                                    else
                                    {
                                        @item.TotalSummary
                                    }
                                </td>
                                <td>
                                    <a asp-page="./Details" target="_blank" rel="noopener"
                                       asp-route-selectDate="@item.SummaryDate.ToString("yyyy-MM-dd")"
                                       asp-route-userId="@Model.UserId"
                                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-primary">查看日报</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<style>
    table > thead > tr > th {
        white-space: nowrap;
    }
</style>

@section Scripts {
    <script>
        AiGeneration.bindLink(
            '#generateSummaryButton',
            '#generateSummaryProgress',
            ['采集项目数据', '整理任务与会议', '生成每日汇总', '保存汇总结果'],
            '生成中...'
        );
    </script>
}
