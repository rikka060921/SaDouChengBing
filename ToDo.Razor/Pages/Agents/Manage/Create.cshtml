@page "{id:int?}"
@model ToDo.Razor.Pages.Agents.Manage.CreateModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "编辑 Agent" : "新建 Agent";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:760px">
    <a asp-page="./Index" class="text-decoration-none small">← Agent 列表</a>
    <h1 class="h3 mt-3">@ViewData["Title"]</h1>
    <p class="text-muted mb-4">告诉它负责什么，系统负责配置和执行。普通任务自动检查，只有需要判断时才请你介入。</p>
    <form method="post" class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Input.Name" class="form-label">名称</label>
                <input asp-for="Input.Name" class="form-control" maxlength="120" placeholder="例如：周报助手" required />
            </div>
            <div class="mb-4">
                <label asp-for="Input.Purpose" class="form-label">主要用途</label>
                @if (Model.Id.HasValue)
                {
                    <input asp-for="Input.Purpose" type="hidden" />
                    <div class="form-control bg-light">@(Model.Purposes.FirstOrDefault(p => p.Key == Model.Input.Purpose)?.Name ?? "用途无效，请返回列表重新打开")</div>
                }
                else
                {
                    <select asp-for="Input.Purpose" class="form-select">
                        @foreach (var purpose in Model.Purposes) { <option value="@purpose.Key">@purpose.Name</option> }
                    </select>
                }
                @foreach (var purpose in Model.Purposes)
                {
                    <div class="form-text purpose-hint" data-purpose="@purpose.Key" hidden="@(purpose.Key != Model.Input.Purpose)">@purpose.Hint</div>
                }
            </div>
            <div class="mb-4">
                <label asp-for="Input.Instructions" class="form-label">工作要求</label>
                <textarea asp-for="Input.Instructions" class="form-control" rows="5" maxlength="1000" required
                    placeholder="例如：汇总本周项目进度，列出延期事项、原因和下周建议。没有依据的内容请明确说明。"></textarea>
                <div class="form-text">用日常语言说明期待的成果即可，不需要编写技术提示词。</div>
            </div>
            <p class="small text-muted">沿用系统默认模型。资料读取和工具使用仍受项目授权限制，不会自动获取额外权限。</p>
            <div class="d-flex justify-content-between align-items-center gap-3">
                @if (Model.Id.HasValue) { <a asp-page="./Technical" asp-route-id="@Model.Id" class="small text-muted">技术配置（维护人员）</a> }
                else { <a asp-page="./Index" class="text-muted">取消</a> }
                <button class="btn btn-primary px-4" type="submit">@(Model.Id.HasValue ? "保存" : "创建并启用")</button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.getElementById('Input_Purpose').addEventListener('change', function () {
            document.querySelectorAll('.purpose-hint').forEach(hint => hint.hidden = hint.dataset.purpose !== this.value);
        });
    </script>
}
