@page
@using ToDo.Entities
@using Microsoft.AspNetCore.Identity
@model ToDo.Razor.Pages.Users.IndexModel
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "用户管理";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<!-- Success/Error Message Display -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">
    <!-- 标题和按钮区域 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">用户列表</h1>
        @if (Model.IsAdmin)
        {
            <div class="d-flex gap-2">
                <a asp-page="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> 添加新用户
                </a>
                <a asp-page="./RecycleBin" class="btn btn-outline-secondary">
                    <i class="bi bi-trash"></i> 查看回收站
                </a>
            </div>
        }
    </div>

    <!-- 筛选区域 - 使用卡片式布局 -->
    <div class="card mb-4 p-3">
        <form method="get">
            <div class="row g-3">
                <!-- 用户名搜索 -->
                <div class="col-md-6">
                    <label class="form-label">搜索用户</label>
                    <input asp-for="SearchString" class="form-control" placeholder="输入用户名搜索">
                </div>

                <!-- 状态筛选 -->
                <div class="col-md-3">
                    <label class="form-label">用户状态</label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">全部状态</option>
                        <option value="Active">激活</option>
                        <option value="Inactive">禁用</option>
                    </select>
                </div>

                <!-- 操作按钮 -->
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> 查询
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary ms-2 w-100">重置</a>
                </div>
            </div>

            <!-- 分页参数 -->
            <input type="hidden" asp-for="CurrentPage" value="1" />
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped" style="table-layout: fixed;">
            <colgroup>
                <col style="width: 120px">
                <col style="width: 100px">
                <col style="width: 180px">
                <col style="width: 80px">
                <col style="width: 100px">
                <col style="width: 80px">
                <col style="width: 140px">
                <col style="width: 100px"> <!-- 编辑列 -->
                <col style="width: 100px"> <!-- 禁用/激活列 -->
                <col style="width: 100px"> <!-- 删除列 -->
            </colgroup>
            <thead class="bg-primary text-white">
                <tr>
                    <th>用户名</th>
                    <th>真实姓名</th>
                    <th>邮箱</th>
                    <th>性别</th>
                    <th>角色</th>
                    <th>状态</th>
                    <th>创建时间</th>
                    <th>编辑</th>
                    <th>禁用/激活</th>
                    <th>删除</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="text-truncate" title="@user.UserName">@user.UserName</td>
                            <td class="text-truncate" title="@user.RealName">@user.RealName</td>
                            <td class="text-truncate" title="@user.Email">@user.Email</td>
                            <td>@user.Gender</td>
                            <td>@user.Role</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(user.Status)">
                                    @user.Status
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (Model.CanEditUser(user.Id))
                                {
                                    <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i> 编辑
                                    </a>
                                }
                                else
                                {
                                    <!-- 保持"编辑"文字，变灰显示 -->
                                    <button class="btn btn-sm btn-primary" disabled>
                                        <i class="bi bi-pencil"></i> 编辑
                                    </button>
                                }
                            </td>
                            <td>
                                @if (!user.IsDeleted && Model.CanToggleStatus(user.Id))
                                {
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id"
                                          onsubmit="return confirm('确定要切换此用户的状态吗？');">
                                        <!-- 修改后（文字动态显示“激活/禁用”） -->
<button type="submit" class="btn btn-sm @(user.Status == UserStatus.Active ? "btn-warning" : "btn-success")">
    <i class="bi @(user.Status == UserStatus.Active ? "bi-lock-fill" : "bi-unlock-fill")"></i>
    @(user.Status == UserStatus.Active ? "禁用" : "激活")
</button>
                                    </form>
                                }
                                else
                                {
                                    <!-- 显示"操作"文字，添加锁图标，变灰显示 -->
                                    <button class="btn btn-sm btn-warning" disabled>
                                        <i class="bi bi-lock-fill"></i> 操作
                                    </button>
                                }
                            </td>
                            <td>
                                @if (!user.IsDeleted && Model.CanDeleteUser(user.Id))
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id"
                                          onsubmit="return confirm('确定要将此用户移至回收站吗？');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash-fill"></i> 删除
                                        </button>
                                    </form>
                                }
                                else if (user.IsDeleted)
                                {
                                    <form method="post" asp-page-handler="Restore" asp-route-id="@user.Id"
                                          onsubmit="return confirm('确定要恢复此用户吗？');">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-arrow-counterclockwise"></i> 恢复
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <!-- 保持"删除"文字和垃圾桶图标，变灰显示 -->
                                    <button class="btn btn-sm btn-danger" disabled>
                                        <i class="bi bi-trash-fill"></i> 删除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4">
                             <div class="alert alert-info text-center py-5">
        <i class="bi bi-folder-open text-muted display-4"></i>
        <h4 class="mt-3">暂无符合条件的项目</h4>
        <p>@Html.Raw("您可以点击上方\"创建新用户\"按钮开始管理您的用户。")</p>
    </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 分页部分 -->
    @if (Model.TotalItems > 0)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="d-flex align-items-center">
                <span class="me-2">每页显示：</span>
                <form method="get" class="d-flex align-items-center">
                    <input type="hidden" asp-for="SearchString" />
                    <input type="hidden" asp-for="GenderFilter" />
                    <input type="hidden" asp-for="CurrentPage" value="1" />
                    <input type="hidden" asp-for="ShowDeleted" />
                    
                    <select asp-for="PageSize" class="form-select form-select-sm" style="width: 100px;" 
                            onchange="this.form.submit()">
                        <option value="2">2人/页</option>
                        <option value="10">10 人/页</option>
                        <option value="15">15 人/页</option>
                    </select>
                </form>
            </div>
            
            <!-- 分页导航 -->
            <div class="flex-grow-1 d-flex justify-content-center">
                <nav aria-label="分页导航">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" 
                               asp-page="./Index"
                               asp-route-currentPage="1"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               aria-label="首页">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" 
                               asp-page="./Index"
                               asp-route-currentPage="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               aria-label="上一页">
                                <span aria-hidden="true">&lsaquo;</span>
                            </a>
                        </li>
                        <li class="page-item active" aria-current="page">
                            <span class="page-link">第 @Model.CurrentPage 页 / 共 @Model.TotalPages 页</span>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" 
                               asp-page="./Index"
                               asp-route-currentPage="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               aria-label="下一页">
                                <span aria-hidden="true">&rsaquo;</span>
                            </a>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" 
                               asp-page="./Index"
                               asp-route-currentPage="@Model.TotalPages"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               aria-label="末页">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
            
            <div style="width: 150px;"></div>
        </div>
    }

@section Styles {
    <style>
        /* 禁用按钮样式 */
        .btn.disabled, 
        .btn:disabled,
        .btn.disabled:hover, 
        .btn:disabled:hover,
        .btn.disabled:focus, 
        .btn:disabled:focus {
            opacity: 0.65;
            cursor: not-allowed;
            background-color: #6c757d !important; /* 灰色背景 */
            border-color: #6c757d !important; /* 灰色边框 */
            color: #fff !important; /* 白色文字 */
        }
        
        /* 特殊按钮样式保持 */
        .btn-warning.text-dark:disabled {
            background-color: #6c757d !important;
            border-color: #6c757d !important;
            color: #fff !important;
        }
        
        .btn-danger.text-white:disabled {
            background-color: #6c757d !important;
            border-color: #6c757d !important;
            color: #fff !important;
        }
        
        .pagination {
            margin-bottom: 0;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 设置当前选中的分页大小
            document.querySelector('select[name="PageSize"]').value = @Model.PageSize;
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(UserStatus status)
    {
        return status switch
        {
            UserStatus.Active => "bg-success",
            UserStatus.Inactive => "bg-secondary",
            
            _ => "bg-light text-dark"
        };
    }
}
