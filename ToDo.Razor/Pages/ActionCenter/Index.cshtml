@page
@model ToDo.Razor.Pages.ActionCenter.IndexModel
@{
    ViewData["Title"] = "待我处理";
}
<div class="container py-4" style="max-width: 1000px">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="page-heading">待我处理 <span class="badge rounded-pill bg-light text-dark fs-6">@Model.TotalPending</span></h1>
            <p class="page-subtitle mb-1">只处理需要你出手的事，AI 正常执行的工作留在任务看板。</p>
            <div class="small text-muted">严重阻塞与重要决策优先，其次是逾期、今天到期和其他待处理。同一任务已合并。</div>
        </div>
        <a asp-page="/Tasks/Index" class="btn btn-outline-secondary btn-sm">查看全部任务</a>
    </div>
    @if (Model.MyActiveTaskCount > 0)
    {
        <div class="card mb-3 border-primary"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div><h2 class="h5 mb-1">我负责的工作 <span class="badge bg-light text-dark">@Model.MyActiveTaskCount</span></h2><p class="small text-muted mb-0">这些任务还在推进，不必等到临期才处理；进入任务可更新进展或请 AI 协助。</p></div>
            <a asp-page="/Tasks/Index" asp-route-MyWork="true" class="btn btn-primary btn-sm">查看我的任务</a>
        </div></div>
    }
    @if (Model.TotalPending == 0)
    {
        <div class="card shadow-sm"><div class="card-body text-center py-5">
            <div class="display-6 mb-2" aria-hidden="true">✓</div><h2 class="h4">目前没有需要你立即处理的提醒</h2>
            <p class="text-muted mb-0">没有提醒不代表没有任务。你负责的工作可从上方入口查看；AI 正常执行时无需逐项确认。</p>
        </div></div>
    }
    else
    {
        <p class="small text-muted">共 @Model.TotalPending 件事，其中 @Model.UrgentCount 件优先或逾期待处理。处理完成后会自动移出，无需另外勾选。</p>
        @foreach (var item in Model.Items)
        {
            var badge = item.Priority switch { 0 => "bg-danger", 1 => "bg-danger", 2 => "bg-warning text-dark", _ => "bg-light text-dark" };
            <article class="card shadow-sm mb-3" data-action-key="@item.Key">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                        <span class="badge @badge align-self-start">@item.PriorityLabel</span>
                        <span class="small text-muted">@item.ProjectName · @(item.Deadline.HasValue ? $"截止 {item.Deadline:MM-dd HH:mm}" : "未设截止时间")</span>
                    </div>
                    <h2 class="h5 text-break">@item.Title</h2>
                    <div class="small text-muted mb-3">为什么找我：@string.Join("；", item.WhyMe)</div>
                    <ul class="ps-3 mb-3 text-break">
                        @foreach (var reason in item.Reasons) { <li class="mb-1">@reason</li> }
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                        @for (var index = 0; index < item.Actions.Count; index++)
                        {
                            var action = item.Actions[index];
                            <a href="@action.Url" class="btn btn-sm @(index == 0 ? "btn-primary" : "btn-outline-secondary")">@action.Label</a>
                        }
                    </div>
                </div>
            </article>
        }
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="待办分页" class="d-flex justify-content-between align-items-center mt-4">
                @if (Model.PageNumber > 1) { <a asp-page="/ActionCenter/Index" asp-route-PageNumber="@(Model.PageNumber - 1)" class="btn btn-outline-secondary btn-sm">上一页</a> }
                else { <span></span> }
                <span class="small text-muted">第 @Model.PageNumber / @Model.TotalPages 页</span>
                @if (Model.PageNumber < Model.TotalPages) { <a asp-page="/ActionCenter/Index" asp-route-PageNumber="@(Model.PageNumber + 1)" class="btn btn-outline-secondary btn-sm">下一页</a> }
                else { <span></span> }
            </nav>
        }
    }
</div>
