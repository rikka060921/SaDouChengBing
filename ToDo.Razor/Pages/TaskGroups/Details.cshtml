@page "{id:int?}/{projectId:int?}"
@using ToDo.Entities
@model ToDo.Razor.Pages.TaskGroups.DetailsModel

@{
	ViewData["Title"] = "任务组详情";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="wwwroot/css/site.css" />

<div class="container py-4">
	<div class="card shadow-lg border-0 rounded-3">
		<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
			<h4 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>分组详情</h4>
		</div>

		<div class="card-body">
			<div class="row mb-3">
				<div class="col-md-6">
					<h6 class="text-muted">分组标题</h6>
					<p class="fs-5 fw-semibold">@Model.TaskGroup.Name</p>
				</div>
			</div>

			<div class="row mb-3">
				<div class="col-md-6">
					<h6 class="text-muted">创建人</h6>
					<p><i class="bi bi-person-circle me-1"></i>@Model.TaskGroup.Creator?.UserName</p>
				</div>
				<div class="col-md-6">
					<h6 class="text-muted">所属项目</h6>
					<p><i class="bi bi-folder2-open me-1"></i>@Model.TaskGroup.Project?.Name</p>
				</div>
				<div class="col-md-6">
					<h6 class="text-muted">下属任务数量</h6>
					<p><i class="bi bi-folder2-open me-1"></i>@Model.TaskGroup.Tasks.Count</p>
				</div>
			</div>

			<div class="card-header bg-light fw-bold">
				分组描述
			</div>
			<div class="card-body">
				@if (string.IsNullOrWhiteSpace(Model.TaskGroup.Description))
				{
					<p class="text-muted">暂无描述。</p>
				}
				else
				{
					@Html.Raw(Model.DescriptionHtml)
				}
			</div>
		</div>

		<div class="card-footer text-end">
			@if (Model.ProjectRole)
			{
				// 显示
				<a asp-page="/TaskGroups/Edit"
				   asp-route-projectId="@Model.TaskGroup.ProjectId"
				   asp-route-id="@Model.TaskGroup.Id"
				   asp-route-returnPage="TaskGroups/Details"
				   asp-route-returnId="@Model.TaskGroup.Id"
				   class="btn btn-outline-primary me-2">
					<i class="bi bi-pencil-square"></i> 编辑
				</a>
			}
			else
			{
				<a asp-page="/TaskGroups/Edit"
				   asp-route-projectId="@Model.TaskGroup.ProjectId"
				   asp-route-id="@Model.TaskGroup.Id"
				   asp-route-returnPage="TaskGroups/Details"
				   asp-route-returnId="@Model.TaskGroup.Id"
				   class="btn btn-outline-primary me-2 disabled">
					<i class="bi bi-pencil-square"></i> 编辑
				</a>
			}
			<a asp-page="/TaskGroups/Index"
			   asp-route-projectId="@Model.TaskGroup.ProjectId"
			   asp-route-returnPage="TaskGroups/Index"
			   asp-route-returnId="@Model.TaskGroup.Id"
			   class="btn btn-outline-secondary">
				<i class="bi bi-arrow-left"></i> 返回
			</a>
		</div>
	</div>
</div>

<div class="container my-4">
	@* <div class="mb-3">
		<form method="get" class="d-flex">
			<input type="hidden" name="id" value="@Model.TaskGroup.Id" />
			<input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="搜索任务标题" class="form-control me-2" />
			<button type="submit" class="btn btn-primary">搜索</button>
		</form>
	</div> *@

	<!-- 筛选区域 -->
	<div class="card mb-4 p-3 shadow-sm">
		<form method="get">
			<div class="row g-3">
				<!-- 隐藏字段：当前任务组ID -->
				<input type="hidden" name="id" value="@Model.TaskGroup.Id" />

				<!-- 搜索任务标题 -->
				<div class="col-md-4">
					<label class="form-label fw-semibold">任务标题</label>
					<input type="text" name="SearchTerm" value="@Model.SearchTerm"
						   placeholder="请输入任务标题" class="form-control" />
				</div>

				<div class="col-md-4">
					<label class="form-label fw-semibold">截止日期</label>
					@* <input type="date" class="form-control" placeholder="结束日期" /> *@
					<input type="date" name="EndDate" value="@Model.EndDate"
						   placeholder="截止日期" class="form-control" />
				</div>

				<!-- 状态筛选 -->
				<div class="col-md-4">
					<label class="form-label fw-semibold">状态</label>
					<select name="Status" class="form-select" asp-for="Status" asp-items="Model.StatusList"></select>
				</div>

				<!-- 优先级筛选 -->
				<div class="col-md-4">
					<label class="form-label fw-semibold">优先级</label>
					<select name="Priority" class="form-select" asp-for="Priority" asp-items="Model.PriorityList"></select>
				</div>

				<!-- 认领人 -->
				<div class="col-md-4">
					<label class="form-label fw-semibold">认领人</label>
					<select asp-for="Assignee" class="form-select" asp-items="Model.Assignees">
						<option value="">全部</option>
					</select>
				</div>

				<!-- 按钮组 -->
				<div class="col-md-4 d-flex align-items-end">
					<button type="submit" class="btn btn-outline-primary w-50">
						<i class="bi bi-search"></i> 筛选
					</button>
					<a asp-page="Details" asp-route-id="@Model.TaskGroup.Id" asp-route-projectId="@Model.CurrentProjectId"
					   class="btn btn-outline-secondary ms-2 w-50">
						<i class="bi bi-arrow-clockwise"></i> 重置
					</a>
				</div>
			</div>
		</form>
	</div>
</div>

<div class="table-responsive">
	<div class="table-responsive">
		<table class="table table-hover table-striped" style="table-layout: fixed;">
			<thead class="bg-primary text-white">
				<tr>
					<th>任务标题</th>
					<th>状态</th>
					<th>优先级</th>
					@* <th>开始时间</th> *@
					<th>负责人</th>
					<th>结束时间</th>
					<th>操作</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var task in Model.Tasks)
				{
					<tr>
						<td>@task.Title</td>
						<td>
							@switch (task.Status)
							{
								case ToDo.Entities.TaskStatus.NotStarted:
									<span class="badge bg-secondary">未开始</span>
									;
									break;
								case ToDo.Entities.TaskStatus.InProgress:
									<span class="badge bg-info text-dark">进行中</span>
									;
									break;
								case ToDo.Entities.TaskStatus.Completed:
									<span class="badge bg-success">已完成</span>
									;
									break;
								default:
									<span class="badge bg-warning text-dark">@task.Status</span>
									;
									break;
							}
						</td>
						<td>@task.Priority</td>
						@* <td>@(task.StartTime?.ToString("yyyy-MM-dd") ?? "-")</td> *@
						<td>@(task.Assignee?.UserName)</td>
						<td>@(task.EndTime?.ToString("yyyy-MM-dd") ?? "-")</td>
						<td>
							@if (Model.ProjectRole)
							{
								<a asp-page="/Tasks/Edit"
								   asp-route-id="@task.Id"
								   asp-route-projectId="@Model.CurrentProjectId"
								   asp-route-returnPage="TaskGroups/Details"
								   asp-route-returnId="@task.GroupId"
								   class="btn btn-sm btn-info">
									编辑
								</a>
							}
							else
							{
								<a asp-page="/Tasks/Edit"
								   asp-route-id="@task.Id"
								   asp-route-projectId="@Model.CurrentProjectId"
								   asp-route-returnPage="TaskGroups/Details"
								   asp-route-returnId="@task.GroupId"
								   class="btn btn-sm btn-secondary disabled">
									编辑
								</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>

		@if (Model.Tasks.Count == 0)
		{
			<div class="alert alert-info text-center py-5">
				<i class="bi bi-folder-open text-muted display-4"></i>
				<h4 class="mt-3">暂无任务</h4>
				@* <p>@Html.Raw("您可以点击上方\"创建新任务\"按钮开始管理您的任务。")</p> *@
			</div>
		}

		<!--分页-->
		@if (Model.Tasks.Count != 0)
		{
			<nav aria-label="分页导航" class="pagination-container">
				<ul class="pagination justify-content-center">
					<!-- 首页按钮 -->
					<li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
						<a class="page-link"
						   asp-route-id="@Model.TaskGroup.Id"
						   asp-route-pageIndex="1"
						   asp-route-SearchTerm="@Model.SearchTerm"
						   aria-label="首页">
							<span aria-hidden="true">&laquo;</span>
						</a>
					</li>

					<!-- 上一页按钮 -->
					<li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
						<a class="page-link"
						   asp-route-id="@Model.TaskGroup.Id"
						   asp-route-pageIndex="@(Model.CurrentPage - 1)"
						   asp-route-SearchTerm="@Model.SearchTerm"
						   aria-label="上一页">
							<span aria-hidden="true">&lsaquo;</span>
						</a>
					</li>

					<!-- 当前页/总页数 -->
					<li class="page-item active" aria-current="page">
						<span class="page-link">
							第 @Model.CurrentPage 页 / 共 @Model.TotalPages 页
						</span>
					</li>

					<!-- 下一页按钮 -->
					<li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
						<a class="page-link"
						   asp-route-id="@Model.TaskGroup.Id"
						   asp-route-pageIndex="@(Model.CurrentPage + 1)"
						   asp-route-SearchTerm="@Model.SearchTerm"
						   aria-label="下一页">
							<span aria-hidden="true">&rsaquo;</span>
						</a>
					</li>

					<!-- 末页按钮 -->
					<li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
						<a class="page-link"
						   asp-route-id="@Model.TaskGroup.Id"
						   asp-route-pageIndex="@Model.TotalPages"
						   asp-route-SearchTerm="@Model.SearchTerm"
						   aria-label="末页">
							<span aria-hidden="true">&raquo;</span>
						</a>
					</li>
				</ul>
			</nav>
		}

		<!--多余-->
		@* <a asp-page="/TaskGroups/Index" asp-route-projectId="@Model.CurrentProjectId" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left me-1"></i>返回
		</a> *@
	</div>
</div>
