@page
@model ToDo.Razor.Pages.ProjectStatsModel
@{
    ViewData["Title"] = "项目数据统计";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-4">
    <h1 class="mb-4 text-center">项目数据可视化看板</h1>

    <!-- 四图表布局：2行×2列 -->
    <div class="row g-4 mb-4">
        <!-- 1. 活跃项目成员数量 -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">活跃项目成员数量分布</h5>
                </div>
                <div class="card-body">
                    <canvas id="activeProjectsChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- 2. 成员参与项目数 -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">成员参与项目数 Top10</h5>
                </div>
                <div class="card-body">
                    <canvas id="participationChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- 3. 项目状态占比（活跃/归档） -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">项目状态占比分析</h5>
                </div>
                <div class="card-body">
                    <canvas id="projectStatusChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- 4. 项目创建时间趋势 -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">项目创建月度趋势</h5>
                </div>
                <div class="card-body">
                    <canvas id="projectCreationChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. 活跃项目成员数量图表
    const activeProjects = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveProjects));
    new Chart(document.getElementById('activeProjectsChart'), {
        type: 'bar',
        data: {
            labels: activeProjects.map(item => item.ProjectName),
            datasets: [{
                label: '成员数量',
                data: activeProjects.map(item => item.MemberCount),
                backgroundColor: 'rgba(54, 162, 235, 0.7)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: '成员数量' }
                },
                x: {
                    title: { display: true, text: '项目名称' },
                    ticks: {
                        autoSkip: false,
                        maxRotation: 0,
                        minRotation: 0,
                        callback: function(value) {
                            const label = this.getLabelForValue(value);
                            if (label.length > 10) {
                                return label.substring(0, 10) + '\n' + label.substring(10);
                            }
                            return label;
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return `成员数: ${context.raw}`;
                        }
                    }
                }
            }
        }
    });

    // 2. 成员参与项目数图表
    const participationData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserParticipations));
    new Chart(document.getElementById('participationChart'), {
        type: 'bar',
        data: {
            labels: participationData.map(item => item.UserName),
            datasets: [{
                label: '参与项目数',
                data: participationData.map(item => item.ProjectCount),
                backgroundColor: 'rgba(75, 192, 192, 0.7)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: '参与项目数' }
                },
                x: {
                    title: { display: true, text: '成员姓名' },
                    ticks: {
                        autoSkip: false,
                        maxRotation: 0,
                        minRotation: 0,
                        callback: function(value) {
                            const label = this.getLabelForValue(value);
                            if (label.length > 6) {
                                return label.substring(0, 6) + '\n' + label.substring(6);
                            }
                            return label;
                        }
                    }
                }
            }
        }
    });

    // 3. 项目状态占比图表（基于IsArchived字段）
    const projectStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectStatusData));
    new Chart(document.getElementById('projectStatusChart'), {
        type: 'doughnut',
        data: {
            labels: ['活跃项目', '归档项目'],
            datasets: [{
                label: '项目数量',
                data: [projectStatusData.ActiveCount, projectStatusData.ArchivedCount],
                backgroundColor: [
                    'rgba(54, 162, 235, 0.7)',
                    'rgba(255, 159, 64, 0.7)'
                ],
                borderColor: [
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.raw || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = Math.round((value / total) * 100);
                            return `${label}: ${value} 个 (${percentage}%)`;
                        }
                    }
                }
            },
            cutout: '60%'
        }
    });

    // 4. 项目创建时间趋势图表
    const projectCreationData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectCreationTrend));
    new Chart(document.getElementById('projectCreationChart'), {
        type: 'bar',
        data: {
            labels: projectCreationData.map(item => item.Month),
            datasets: [
                {
                    label: '活跃项目',
                    data: projectCreationData.map(item => item.ActiveCount),
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                },
                {
                    label: '归档项目',
                    data: projectCreationData.map(item => item.ArchivedCount),
                    backgroundColor: 'rgba(255, 159, 64, 0.7)',
                    borderColor: 'rgba(255, 159, 64, 1)',
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: '项目数量' },
                    stacked: true
                },
                x: {
                    title: { display: true, text: '月份' }
                }
            },
            plugins: {
                tooltip: {
                    mode: 'index',
                    intersect: false
                }
            }
        }
    });
</script>
