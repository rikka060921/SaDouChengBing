@page
@model ToDo.Razor.Pages.Reports.IndexModel
@{
    var activeTab = Model.Tab ?? "project";
    var pageTitle = activeTab == "team" ? "成员日报列表" : "项目报告列表";
    ViewData["Title"] = pageTitle;
    // 定义隔行颜色（暗→亮交替，加深对比）
    string darkRowColor = "#f2f2f2"; // 深灰色（第一行、第三行等奇数行）
    string lightRowColor = "#ffffff"; // 白色（第二行、第四行等偶数行）

    // 自定义表头蓝色（可根据实际需求调整色值）
    string headerBgColor = "#007bff"; // 与之前图片匹配的蓝色
    string headerTextColor = "white";  // 表头文字为白色
}
<style>
    /* 详情按钮样式，与表头颜色保持一致 */
    .btn-detail {
        background-color: @headerBgColor !important;
        color: white !important;
        border-color: @headerBgColor !important;
    }

        .btn-detail:hover {
            background-color: #0056b3 !important; /* 悬停时稍深的蓝色 */
            border-color: #0056b3 !important;
        }
</style>

<div class="container mt-4">
    @{
        ViewData["WorkReportSection"] = activeTab;
        ViewData["CanViewMemberReports"] = Model.IsAnyProjectLeader;
    }
    <partial name="_WorkReportNav" view-data="ViewData" />
    <!-- 标题与按钮组 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-heading">@pageTitle</h1>
            <p class="page-subtitle">@(activeTab == "team"
                ? "按项目汇总成员每天做了什么，仅展示你有管理权限的项目；原团队日报功能保留。"
                : "查看与项目相关的日报、周报和月报，与成员个人工作汇总分开管理。")</p>
        </div>
        <div>
            @if (activeTab == "team")
            {
                @if (Model.IsAnyProjectLeader)
                {
                    <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#generateTeamReportModal">
                        <i class="fas fa-users"></i> 生成成员日报
                    </button>
                }
            }
            else
            {
                <a asp-page="Charts" class="btn btn-info me-2">图表分析</a>
                <a asp-page="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> 新建项目报告
                </a>
            }
        </div>
    </div>

    <!-- 生成团队汇报弹窗（仅项目管理员可见） -->
    @if (Model.IsAnyProjectLeader)
    {
        <div class="modal fade" id="generateTeamReportModal" tabindex="-1" aria-labelledby="generateTeamReportLabel" aria-hidden="true">
            <div class="modal-dialog">
                <form class="modal-content" method="post" asp-page-handler="GenerateTeamReport" asp-route-tab="team">
                    <div class="modal-header">
                        <h5 class="modal-title" id="generateTeamReportLabel">生成成员日报</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">将基于当日各成员的个人日报，按项目汇总生成成员日报（仅项目管理员可见）。</p>
                        <div class="mb-3">
                            <label class="form-label">项目</label>
                            <select name="projectId" class="form-select" required>
                                <option value="">请选择要生成的项目</option>
                                @foreach (var opt in Model.LeaderProjectOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">汇报日期</label>
                            <input name="reportDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-warning" onclick="return confirm('确认基于当日已生成的个人日报生成成员日报？')">开始生成</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- 筛选区域 -->
    <div class="card mb-4 p-3">
        <form method="get">
            <input type="hidden" name="tab" value="@activeTab" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">所属项目</label>
                    <select asp-for="FilterProjectId" asp-items="Model.ProjectOptions" class="form-select">
                        <option value="">全部项目</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">报告类型</label>
                    @if (activeTab == "team")
                    {
                        <input type="hidden" asp-for="FilterReportType" value="4" />
                        <input class="form-control" value="成员日报汇总" disabled />
                    }
                    else
                    {
                        <select asp-for="FilterReportType" class="form-select">
                            <option value="">全部类型</option>
                            <option value="1">日报</option>
                            <option value="2">周报</option>
                            <option value="3">月报</option>
                        </select>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label">上报人</label>
                    <input asp-for="FilterReporter" class="form-control" placeholder="搜索当前可访问项目的上报人" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">内容关键词</label> <!-- 新增关键词输入框 -->
                    <input asp-for="FilterKeyword" class="form-control" placeholder="搜索内容中的关键词">
                </div>

                <div class="col-md-4">
                    <label class="form-label">开始日期</label>
                    <input asp-for="FilterStartDate" type="date" class="form-control"
                           max="@AppTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-4">
                    <label class="form-label">结束日期</label>
                    <input asp-for="FilterEndDate" type="date" class="form-control"
                           max="@AppTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100">筛选</button>
                    <a asp-page="Index" asp-route-tab="@activeTab" class="btn btn-outline-secondary ms-2 w-100">重置</a>
                </div>
            </div>
        </form>
    </div>

    <!-- 列表区域 -->
    <div class="table-responsive mb-4">
        <table class="table table-hover">
            <!-- 表头改为自定义蓝色且文字白色 -->
            <thead style="background-color: @headerBgColor; color: @headerTextColor;">
                <tr>
                    <th>标题</th>
                    <th>所属项目</th>
                    <th>报告类型</th>
                    <th>报告日期</th>
                    <th>上报人</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DailyReports.Any())
                {
                    // 使用索引控制隔行颜色，确保第一行暗、第二行亮
                    for (int i = 0; i < Model.DailyReports.Count; i++)
                    {
                        var item = Model.DailyReports[i];
                        var reporter = Model.AllUsers.FirstOrDefault(u => u.Id == item.ReporterId);

                        // 索引从0开始：0→暗（第一行）、1→亮（第二行）、2→暗（第三行）...
                        string rowStyle = (i % 2 == 0) ?
                        $"background-color: {darkRowColor};" :
                        $"background-color: {lightRowColor};";

                        <tr style="@rowStyle">
                            <td>@item.ReportTitle</td>
                            <td>@item.Project?.Name</td>
                            <td>
                                @(item.ReportType == 1 ? "日报" :
                                  item.ReportType == 2 ? "周报" :
                                  item.ReportType == 4 ? "成员日报" : "月报")
                    </td>
                    <td>@item.ReportDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (item.IsSystemGenerated)
                        {
                            <span style="color: #6c757d; font-weight: 600;">自动上报</span>
                        }
                        else
                        {
                            @(reporter?.RealName ?? reporter?.UserName)
                        }
                    </td>
                    <td>
                        <!-- 按钮顺序：删除→详情 -->
                        @* 删除按钮 *@
                        @if (Model.CanDeleteDictionary.TryGetValue(item.Id, out bool canDelete) && canDelete)
                                {
                                    <button type="button" class="btn btn-sm btn-danger me-1"
                                            style="color: white;"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal_@item.Id">
                                        删除
                                    </button>
                                }
                                else
                                {
                                    <!-- 无权限时：灰色禁用按钮 -->
                                    <button type="button" class="btn btn-sm btn-secondary me-1" disabled>
                                        删除
                                    </button>
                                }

                                <!-- 查看详情按钮：与表头同色蓝色，白色文字"详情" -->
                                <button type="button" class="btn btn-sm btn-detail me-1"
                                        onclick="location.href='@Url.Page("Details", new { id = item.Id })'">
                                    详情
                                </button>

                                @* 每个项目的删除确认弹窗 *@
                                <div class="modal fade" id="deleteModal_@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">确认删除</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                确定要删除项目报告 <strong>@item.ReportTitle</strong> 吗？此操作不可恢复。
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                                                    <button type="submit" class="btn btn-danger">确认删除</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- 无数据时显示统一的提示样式，占满6列 -->
                    <tr>
                        <td colspan="6">
                            <div class="alert alert-info text-center py-5">
                                <i class="bi bi-folder-open text-muted display-4"></i>
                                <h4 class="mt-3">暂无符合条件的@(activeTab == "team" ? "成员日报" : "项目报告")</h4>
                                <p>
                                    @if (activeTab == "team")
                                    {
                                        @Html.Raw("您可以点击右上角\"生成成员日报\"按钮开始生成成员日报。")
                                    }
                                    else
                                    {
                                        @Html.Raw("您可以点击上方\"新建项目报告\"按钮开始管理项目报告。")
                                    }
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 分页导航 -->
    @if (Model.TotalPages > 0 && Model.DailyReports.Any())
    {
        <nav aria-label="Page navigation" style="border: none;">
            <ul class="pagination justify-content-center" style="margin: 0; border: none;">
                <!-- 首页按钮：&laquo; → «（左双箭头） -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-tab="@activeTab"
                       asp-route-currentPage="1"
                       asp-route-filterProjectId="@Model.FilterProjectId"
                       asp-route-filterReportType="@Model.FilterReportType"
                       asp-route-filterReporter="@Model.FilterReporter"
                       asp-route-filterKeyword="@Model.FilterKeyword"
                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                       aria-label="首页">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- 上一页按钮：&lsaquo; → <（左单箭头） -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-tab="@activeTab"
                       asp-route-currentPage="@(Model.CurrentPage - 1)"
                       asp-route-filterProjectId="@Model.FilterProjectId"
                       asp-route-filterReportType="@Model.FilterReportType"
                       asp-route-filterReporter="@Model.FilterReporter"
                       asp-route-filterKeyword="@Model.FilterKeyword"
                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                       aria-label="上一页">
                        <span aria-hidden="true">&lsaquo;</span>
                    </a>
                </li>

                <!-- 中间页码信息（高亮显示） -->
                <li class="page-item active" style="background-color: #007bff; border-color: #007bff;">
                    <span class="page-link text-white">
                        第 @Model.CurrentPage 页 / 共 @Model.TotalPages 页
                    </span>
                </li>

                <!-- 下一页按钮：&rsaquo; → >（右单箭头） -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-tab="@activeTab"
                       asp-route-currentPage="@(Model.CurrentPage + 1)"
                       asp-route-filterProjectId="@Model.FilterProjectId"
                       asp-route-filterReportType="@Model.FilterReportType"
                       asp-route-filterReporter="@Model.FilterReporter"
                       asp-route-filterKeyword="@Model.FilterKeyword"
                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                       aria-label="下一页">
                        <span aria-hidden="true">&rsaquo;</span>
                    </a>
                </li>

                <!-- 末页按钮：&raquo; → »（右双箭头） -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-tab="@activeTab"
                       asp-route-currentPage="@Model.TotalPages"
                       asp-route-filterProjectId="@Model.FilterProjectId"
                       asp-route-filterReportType="@Model.FilterReportType"
                       asp-route-filterReporter="@Model.FilterReporter"
                       asp-route-filterKeyword="@Model.FilterKeyword"
                       asp-route-filterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                       asp-route-filterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                       aria-label="末页">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // 权限错误提示
        function showPermissionError(action) {
            alert('没有权限' + action + '此项目报告，可能是因为：\n1. 您不是创建者\n2. 已超过24小时编辑时限\n3. 您不是项目管理员或系统管理员');
        }
    </script>
}
