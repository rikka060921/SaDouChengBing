@page "{id:int?}"
@model ToDo.Razor.Pages.Reports.EditModel
@using System.IO;
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "新建项目日报" : "编辑项目日报";
    string timeTip = Model.IsReadOnly
        ? "创建者可在发布后24小时内修改"
        : "创建者可在发布后24小时内修改";
}

<!-- 引入必要样式和脚本 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.7/dist/purify.min.js"></script>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
    </div>

    <!-- 错误提示 -->
    @if (!string.IsNullOrEmpty(Model.ErrorDetails))
    {
        <div class="alert alert-danger mb-4">
            <strong>操作失败：</strong>@Model.ErrorDetails
        </div>
    }

    <!-- 权限提示 -->
    <div class="alert alert-info mb-4">@timeTip</div>

    <!-- 表单 -->
    <form method="post" enctype="multipart/form-data" id="reportForm">
        <!-- 隐藏域 -->
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.ProjectId" />
        <input type="hidden" asp-for="Input.ReporterId" />
        <input type="hidden" id="deletedAttachmentIds" name="DeletedAttachmentIds" value="" />

        <!-- 所属项目 -->
        <div class="mb-3">
            <label class="form-label fw-bold text-dark">项目</label>
            <input type="text" class="form-control"
                   value="@Model.ProjectOptions?.FirstOrDefault(p => p.Value == Model.Input.ProjectId.ToString())?.Text"
                   readonly>
            <div class="form-text text-muted">此字段不可更改</div>
        </div>

        <!-- 报告标题 -->
        <div class="mb-3">
            <label asp-for="Input.ReportTitle" class="form-label fw-bold text-dark required">
                报告标题 <span class="text-danger">*</span>
            </label>
            <input asp-for="Input.ReportTitle"
                   class="form-control @(ViewData.ModelState.ContainsKey("Input.ReportTitle") ? "is-invalid" : "")"
                   required
                   placeholder="支持手动修改，或选择后自动生成"
                   disabled="@Model.IsReadOnly">
            <span asp-validation-for="Input.ReportTitle" class="text-danger"></span>
        </div>

        <!-- 报告日期 + 类型 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Input.ReportDate" class="form-label fw-bold text-dark required">
                    报告日期 <span class="text-danger">*</span>
                </label>
                <input asp-for="Input.ReportDate" type="date"
                       class="form-control @(ViewData.ModelState.ContainsKey("Input.ReportDate") ? "is-invalid" : "")"
                       required
                       onchange="updateTitle()"
                       max="@AppTime.Today.ToString("yyyy-MM-dd")"
                       disabled="@Model.IsReadOnly">
                <span asp-validation-for="Input.ReportDate" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.ReportType" class="form-label fw-bold text-dark required">
                    报告类型 <span class="text-danger">*</span>
                </label>
                <select asp-for="Input.ReportType" asp-items="Model.ReportTypeOptions"
                        class="form-select @(ViewData.ModelState.ContainsKey("Input.ReportType") ? "is-invalid" : "")"
                        required
                        onchange="updateTitle()"
                        disabled="@Model.IsReadOnly">
                    <option value="">请选择类型</option>
                </select>
                <span asp-validation-for="Input.ReportType" class="text-danger"></span>
            </div>
        </div>

        <!-- 创建人信息 -->
        <div class="mb-3">
            <label class="form-label fw-bold text-dark">创建人</label>
            <input type="text" class="form-control"
                   value="@Model.ReporterOptions?.FirstOrDefault(r => r.Value == Model.Input.ReporterId.ToString())?.Text"
                   readonly>
        </div>

        <!-- Markdown编辑器和预览区 -->
        <div class="mb-3">
            <label class="form-label fw-bold text-dark required">
                报告内容（支持Markdown） <span class="text-danger">*</span>
            </label>

            <!-- 工具栏 -->
            <div class="border rounded p-2 bg-light mb-2 d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('**', '**')">粗体 (Ctrl+B)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('*', '*')">斜体 (Ctrl+I)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('# ', '')">一级标题</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('## ', '')">二级标题</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('### ', '')">三级标题</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('- ', '')">无序列表</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('1. ', '')">有序列表</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('```\n', '\n```')">代码块</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('[链接文本](', ')')">链接</button>
            </div>

            <!-- 编辑和预览区域 -->
            <div class="row">
                <!-- 编辑区 -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-light">编辑区</div>
                        <div class="card-body p-0">
                            <textarea asp-for="Input.ReportContent"
                                      class="form-control border-0 rounded-0 h-100"
                                      rows="15"
                                      required
                                      placeholder="请输入日报内容"
                                      disabled="@Model.IsReadOnly"
                                      id="markdown-editor"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 预览区 -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-light">预览区</div>
                        <div class="card-body overflow-auto" id="markdown-preview">
                            <div class="text-muted">实时预览将在这里显示...</div>
                        </div>
                    </div>
                </div>
            </div>

            <span asp-validation-for="Input.ReportContent" class="text-danger"></span>
            <div class="form-text mt-1">
                格式提示：**粗体**、*斜体*、# 标题、- 列表项、```代码块```
            </div>
        </div>

        <!-- 附件管理 -->
        <div class="mb-3">
            <label class="form-label fw-bold text-dark">附件（可选）</label>
            <input type="file" name="NewAttachments" multiple class="form-control"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.txt"
                   id="attachmentInput"
                   disabled="@Model.IsReadOnly">
            <div class="form-text mt-1">
                支持格式：pdf、doc、docx、xls、xlsx、ppt、pptx、jpg、png、txt，单个文件≤10MB，单次上传不超过5个文件
            </div>

            <!-- 现有附件列表 -->
            @if (Model.ExistingAttachments != null && Model.ExistingAttachments.Any())
            {
                <div class="mt-3">
                    <h6>已上传附件</h6>
                    <div class="row mt-2" id="existingAttachments">
                        @foreach (var att in Model.ExistingAttachments)
                        {
                            <div class="col-md-6 mb-2" data-id="@att.Id">
                                <div class="card h-100">
                                    <div class="card-body d-flex align-items-center">
                                        <i class="@att.IconClass fs-3 me-3"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="card-title mb-1 text-truncate">@att.FileName</h6>
                                            <p class="card-text small text-muted mb-0">
                                                @att.FileSizeFormatted ·
                                                @att.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                                            </p>
                                        </div>
                                        <a asp-page="/Reports/Details" asp-page-handler="Download" asp-route-attachmentId="@att.Id" class="btn btn-outline-primary btn-sm me-2">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="removeExistingAttachment(@att.Id)"
                                                @(Model.IsReadOnly ? "disabled" : "")>
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 时间信息 -->
        @if (Model.Input.Id != 0)
        {
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">创建时间</label>
                    <input type="text" class="form-control"
                           value="@Model.ReportCreatedAt.ToString("yyyy-MM-dd HH:mm")"
                           readonly>
                </div>
                @if (Model.ReportLastModifiedAt != Model.ReportCreatedAt)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">最后修改</label>
                        <input type="text" class="form-control"
                               value="@Model.ReportLastModifiedAt.ToString("yyyy-MM-dd HH:mm")"
                               readonly>
                    </div>
                }
            </div>
        }

        <!-- 操作按钮 -->
        <div class="d-flex justify-content-between">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> 返回列表
            </a>

            @if (!Model.IsReadOnly)
            {
                <button type="submit" class="btn btn-primary" id="saveButton">
                    <i class="fas fa-save"></i> @(Model.Input.Id == 0 ? "提交日报" : "保存修改")
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled>
                    <i class="fas fa-lock"></i> 不可修改
                </button>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // 确保DOM完全加载后执行
        document.addEventListener('DOMContentLoaded', function() {
            // 获取DOM元素
            const editor = document.getElementById('markdown-editor');
            const preview = document.getElementById('markdown-preview');
            const form = document.getElementById('reportForm');
            const saveButton = document.getElementById('saveButton');
            const deletedIdsInput = document.getElementById('deletedAttachmentIds');

            // 验证关键元素是否存在
            if (!editor || !preview) {
                console.error('Markdown编辑器或预览区未找到');
                return;
            }

            // 实时预览功能
            function updatePreview() {
                try {
                    const markdown = editor.value || '<div class="text-muted">实时预览将在这里显示...</div>';
                    const html = DOMPurify.sanitize(marked.parse(markdown));
                    preview.innerHTML = html;
                } catch (error) {
                    console.error('预览更新失败:', error);
                    preview.innerHTML = '<div class="text-danger">预览解析出错，请检查Markdown格式</div>';
                }
            }

            // 强制初始化预览
            updatePreview();

            // 绑定输入事件
            editor.addEventListener('input', updatePreview);

            // 插入Markdown语法
            window.insertText = function(prefix, suffix) {
                try {
                    const start = editor.selectionStart;
                    const end = editor.selectionEnd;
                    const selectedText = editor.value.substring(start, end);

                    editor.value =
                        editor.value.substring(0, start) +
                        prefix + selectedText + suffix +
                        editor.value.substring(end);

                    const cursorPos = start + prefix.length + (selectedText ? selectedText.length : 0);
                    editor.focus();
                    editor.setSelectionRange(cursorPos, cursorPos);
                    updatePreview();
                } catch (error) {
                    console.error('插入文本失败:', error);
                }
            };

            // 快捷键支持
            editor.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'b') {
                    e.preventDefault();
                    insertText('**', '**');
                }
                if (e.ctrlKey && e.key === 'i') {
                    e.preventDefault();
                    insertText('*', '*');
                }
            });

            // 附件删除逻辑
            let deletedIds = [];

            window.removeExistingAttachment = function(attachmentId) {
                if (confirm('确定要删除此附件吗？')) {
                    const element = document.querySelector(`[data-id="${attachmentId}"]`);
                    if (element) {
                        element.remove();
                    }

                    if (!deletedIds.includes(attachmentId)) {
                        deletedIds.push(attachmentId);
                        deletedIdsInput.value = deletedIds.join(',');
                    }
                }
            };

            // 新附件上传验证
            const attachmentInput = document.getElementById('attachmentInput');
            if (attachmentInput) {
                attachmentInput.addEventListener('change', function(e) {
                    if (this.files.length > 5) {
                        alert('最多只能上传5个文件');
                        this.value = '';
                        return;
                    }

                    Array.from(this.files).forEach(file => {
                        if (file.size > 10 * 1024 * 1024) {
                            alert(`文件「${file.name}」超过10MB限制`);
                            this.value = '';
                            return;
                        }

                        const allowedExts = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.jpg', '.jpeg', '.png', '.txt'];
                        const ext = file.name.split('.').pop()?.toLowerCase();
                        if (!allowedExts.includes(`.${ext}`)) {
                            alert(`文件「${file.name}」格式不支持`);
                            this.value = '';
                            return;
                        }
                    });
                });
            }

            // 标题自动生成逻辑
            const reportTypeMap = { '1': '日报', '2': '周报', '3': '月报' };

            window.updateTitle = function() {
                const reporterName = '@Model.ReporterOptions?.FirstOrDefault(r => r.Value == Model.Input.ReporterId.ToString())?.Text';
                const typeSelect = document.querySelector('select[name="Input.ReportType"]');
                const dateInput = document.querySelector('input[name="Input.ReportDate"]');
                const titleInput = document.querySelector('input[name="Input.ReportTitle"]');

                if (!@Model.IsReadOnly && reporterName && typeSelect?.value && dateInput?.value && (!titleInput?.value || titleInput.value.trim() === '')) {
                    const typeText = reportTypeMap[typeSelect.value] || '报告';
                    const formattedDate = dateInput.value.replace(/-/g, '');
                    titleInput.value = `${reporterName}_${formattedDate}_${typeText}`;
                }
            };

            // 新建页默认值设置
            @if (Model.Input.Id == 0)
            {
                    <text>
                        const typeSelect = document.querySelector('select[name="Input.ReportType"]');
                        const dateInput = document.querySelector('input[name="Input.ReportDate"]');
                        if (typeSelect && !typeSelect.value) typeSelect.value = '1';
                        if (dateInput && !dateInput.value) dateInput.value = ToDoTime.todayInBeijing();
                        updateTitle();
                    </text>
            }

            // 表单提交处理（关键：确保DeletedAttachmentIds有值）
            if (form && saveButton) {
                form.addEventListener('submit', function(e) {
                    // 强制设置DeletedAttachmentIds为空字符串（避免被视为null）
                    if (!deletedIdsInput.value) {
                        deletedIdsInput.value = "";
                    }

                    // 基础验证
                    const title = document.querySelector('input[name="Input.ReportTitle"]').value;
                    const content = editor.value;

                    if (!title.trim()) {
                        e.preventDefault();
                        alert('请输入报告标题');
                        return false;
                    }

                    if (!content.trim()) {
                        e.preventDefault();
                        alert('请输入报告内容');
                        return false;
                    }

                    // 显示加载状态
                    saveButton.disabled = true;
                    saveButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 保存中...';

                    return true;
                });
            }

            // 只读样式处理
            @if (Model.IsReadOnly)
            {
                    <text>
                        document.querySelectorAll('input:disabled, textarea:disabled, select:disabled')
                            .forEach(el => el.classList.add('bg-light'));
                    </text>
            }
        });
    </script>
}
