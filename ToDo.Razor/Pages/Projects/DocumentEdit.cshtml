@page
@model ToDo.Razor.Pages.Projects.DocumentEditModel
@{
    ViewData["Title"] = Model.DraftId > 0 ? "校订 AI 草稿" : "编辑资料正文";
}
<div class="container py-4" style="max-width:1100px">
    <a asp-page="./Materials" asp-route-projectId="@Model.ProjectId">← 返回项目资料</a>
    <h1 class="h3 mt-3">@ViewData["Title"]</h1>
    <p class="text-muted">@Model.Snapshot?.FileName · @(Model.DraftId > 0 ? "只修改待审核草稿，不自动发布" : "保存为新版本，旧版本与来源仍保留")</p>
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div> }
    @if (Model.Snapshot != null || !string.IsNullOrEmpty(Model.EditedContent))
    {
        <form method="post" id="document-edit-form">
            <input asp-for="ProjectId" type="hidden" /><input asp-for="DocumentId" type="hidden" /><input asp-for="DraftId" type="hidden" /><input asp-for="ExpectedToken" type="hidden" />
            <label asp-for="EditedContent" class="form-label">@(Model.DraftId > 0 ? "调整后的草稿正文" : "资料正文（Markdown / TXT）")</label>
            <textarea asp-for="EditedContent" rows="20" maxlength="100000" class="form-control font-monospace" required spellcheck="false"></textarea>
            <div class="form-text">最多 10 万字符。这里编辑文本，不修改 Office 原件版式；不支持的原件请下载后处理。</div>
            @if (Model.Snapshot != null) { <details class="mt-3"><summary>对照修改前正文</summary><pre class="bg-light border rounded p-3 text-wrap" style="max-height:350px;overflow:auto">@Model.Snapshot.Content</pre></details> }
            <div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-primary" id="save-document">@(Model.DraftId > 0 ? "保存草稿校订（不发布）" : "保存新版本")</button><a asp-page="./Materials" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">取消</a></div>
        </form>
    }
</div>
@section Scripts {
<script>
(() => {
    const form = document.getElementById('document-edit-form');
    if (!form) return;
    let dirty = false;
    form.querySelector('textarea').addEventListener('input', () => dirty = true);
    form.addEventListener('submit', () => { dirty = false; document.getElementById('save-document').disabled = true; });
    window.addEventListener('beforeunload', event => { if (dirty) { event.preventDefault(); event.returnValue = ''; } });
})();
</script>
}
