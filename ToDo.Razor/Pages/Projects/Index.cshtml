@page
@model ToDo.Razor.Pages.Projects.IndexModel
@using ToDo.Entities;
@{
    ViewData["Title"] = "项目列表";
}

<!-- 添加成功消息显示 -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 添加错误消息显示 -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 标题和新建按钮区域 -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="page-heading">项目</h1><div class="page-subtitle">进入项目空间，统一管理任务、资料与会议。</div></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex gap-2">
            <a href="/Projects/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> 新建项目
            </a>
            <!-- 修复：正确跳转，传projectId=0 -->
            <a asp-page="/Tasks/SplitTask" asp-route-projectId="0" class="btn btn-outline-secondary">
                <i class="bi bi-magic"></i> AI 任务拆分
            </a>
        </div>
    }
</div>

<nav class="nav nav-pills gap-2 mb-3" aria-label="项目状态视图">
    @foreach (var tab in new[] { ("active", "活跃项目"), ("archived", "已归档"), ("all", "全部") })
    {
        <a asp-page="Index" asp-route-View="@tab.Item1" asp-route-Keyword="@Model.Keyword" asp-route-PageSize="@Model.PageSize"
           class="nav-link @(Model.View == tab.Item1 ? "active" : "")" aria-current="@(Model.View == tab.Item1 ? "page" : null)">@tab.Item2</a>
    }
</nav>
<!-- 筛选区域 - 使用卡片式布局 -->
<div class="filter-panel mb-4">
    <form method="get">
        <div class="row g-3">
            <!-- 关键词搜索 -->
            <div class="col-md-6">
                <label class="form-label">搜索项目</label>
                <input asp-for="Keyword" class="form-control" placeholder="输入项目名称或描述">
            </div>

            <!-- 状态筛选 -->
            <div class="col-md-3">
                <label asp-for="PageSize" class="form-label">每页数量</label>
                <select asp-for="PageSize" class="form-select">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <input type="hidden" asp-for="View" />
            </div>

            <!-- 操作按钮 -->
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search"></i> 查询
                </button>
                <a asp-page="Index" class="btn btn-light">重置</a>
            </div>
        </div>

        <!-- 分页参数 -->
        <input type="hidden" asp-for="PageIndex" value="1" />
    </form>
</div>

<div class="table-responsive">
        <table class="table table-hover table-striped" style="table-layout: fixed;">
            <colgroup>
                <col style="width: 180px">
                <col style="width: 320px">
                <col style="width: 130px">
                <col style="width: 100px">
                <col style="width: 70px">
                <col style="width: 110px">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" class=" align-top">项目名称</th>
                    <th scope="col" class=" align-top">描述</th>
                    <th scope="col" class=" align-top">创建时间</th>
                    <th scope="col" class=" align-top">创建人</th>
                    <th scope="col" class=" align-top">状态</th>
                    <th scope="col" class=" align-top">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects)
                {
                    // 检查用户是否有权限管理该项目
                    bool canManageProject = await Model.CanManageProjectAsync(project.Id);
                    bool isProjectActive = project.Status == ProjectStatus.Active;

                    <tr data-project-id="@project.Id" data-project-status="@project.Status">
                        <td class="text-truncate" title="@project.Name">@project.Name</td>
                        <td class="text-truncate" title="@project.Description">
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                var displayText = project.Description.Length > 80
                                ? project.Description.Substring(0, 80) + "..."
                                : project.Description;
                                @displayText
                            }
                            else
                            {
                                @:"-"
                            }
                        </td>
                        <td>@AppTime.ToBeijingTime(project.CreatedAt).ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-truncate" title="@project.CreatedByUserName">@project.CreatedByUserName</td>
                        <td>
                            <span class="badge @(project.Status == ProjectStatus.Archived ? "bg-secondary" : "bg-success")">
                                @(project.Status == ProjectStatus.Archived ? "已归档" : "活跃")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <a href="/Projects/Details/@project.Id" class="btn btn-sm btn-outline-primary">打开</a>
                                @if (isProjectActive || canManageProject)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="更多操作"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @if (isProjectActive)
                                            {
                                                <li><a asp-page="/Tasks/Index" asp-route-projectId="@project.Id" class="dropdown-item">查看任务</a></li>
                                            }
                                            @if (canManageProject && isProjectActive)
                                            {
                                                <li><a asp-page="/TaskGroups/Index" asp-route-projectId="@project.Id" class="dropdown-item">管理分组</a></li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li><button class="dropdown-item archive-btn" data-project-id="@project.Id" data-current-filter="@(Model.IsArchivedFilter?.ToString().ToLower())">归档项目</button></li>
                                            }
                                            else if (canManageProject)
                                            {
                                                <li><button class="dropdown-item restore-btn" data-project-id="@project.Id" data-current-filter="@(Model.IsArchivedFilter?.ToString().ToLower())">恢复项目</button></li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

@if (!Model.Projects.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-folder-open text-muted display-4"></i>
        <h4 class="mt-3">暂无符合条件的项目</h4>
        <p>@Html.Raw("您可以点击上方\"创建新项目\"按钮开始管理您的项目。")</p>
    </div>
}
</div>
@if (Model.TotalCount > 0)
{
    <nav aria-label="分页导航">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageIndex="1" asp-route-Keyword="@Model.Keyword" asp-route-View="@Model.View" asp-route-PageSize="@Model.PageSize" aria-label="首页">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageIndex="@(Model.PageIndex - 1)" asp-route-Keyword="@Model.Keyword" asp-route-View="@Model.View" asp-route-PageSize="@Model.PageSize" aria-label="上一页">
                    <span aria-hidden="true">&lsaquo;</span>
                </a>
            </li>
            <li class="page-item active" aria-current="page">
                <span class="page-link">第 @Model.PageIndex 页 / 共 @(Math.Ceiling((double)Model.TotalCount / Model.PageSize)) 页</span>
            </li>
            <li class="page-item @(Model.PageIndex >= Math.Ceiling((double)Model.TotalCount / Model.PageSize) ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageIndex="@(Model.PageIndex + 1)" asp-route-Keyword="@Model.Keyword" asp-route-View="@Model.View" asp-route-PageSize="@Model.PageSize" aria-label="下一页">
                    <span aria-hidden="true">&rsaquo;</span>
                </a>
            </li>
            <li class="page-item @(Model.PageIndex >= Math.Ceiling((double)Model.TotalCount / Model.PageSize) ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageIndex="@(Math.Ceiling((double)Model.TotalCount / Model.PageSize))" asp-route-Keyword="@Model.Keyword" asp-route-View="@Model.View" asp-route-PageSize="@Model.PageSize" aria-label="末页">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.querySelector('tbody').addEventListener('click', async function(e) {
            const btn = e.target.closest('.archive-btn, .restore-btn');
            if (!btn || btn.disabled) return;
            e.preventDefault();
            const isArchive = btn.classList.contains('archive-btn');
            const projectId = btn.dataset.projectId;
            btn.disabled = true;
            try {
                let question = '恢复该项目？恢复后只处理新工作，不补跑归档期间的自动任务。';
                if (isArchive) {
                    const response = await fetch('?handler=ArchiveCheck&projectId=' + encodeURIComponent(projectId));
                    if (!response.ok) throw new Error('无法检查归档条件，请刷新后重试。');
                    const check = await response.json();
                    if (!check.success) { alert(check.message || '暂时不能归档'); return; }
                    question = '归档后保留历史，停止业务写入和自动推进。';
                    if (check.data.unfinishedTasks > 0)
                        question += '\n还有 ' + check.data.unfinishedTasks + ' 项未完成任务，其状态和进度不会改变。';
                    question += '\n确认归档？';
                }
                if (!confirm(question)) return;
                const data = new FormData();
                data.append('projectId', projectId);
                data.append('shouldArchive', isArchive);
                data.append('confirmUnfinishedTasks', isArchive);
                const response = await fetch('?handler=Archive', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: data
                });
                if (!response.ok) throw new Error('操作未成功，请刷新后重试。');
                const result = await response.json();
                if (!result.success) { alert(result.message || '操作失败'); return; }
                window.location.reload();
            } catch (error) {
                alert(error.message || '操作失败，请重试');
            } finally {
                btn.disabled = false;
            }
        });
    </script>
}
