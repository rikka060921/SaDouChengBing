@page
@model ToDo.Razor.Pages.Projects.DocumentPreviewModel
@using ToDo.Razor.Utilities
@{
    ViewData["Title"] = "Markdown 资料预览";
}
@section Styles {
    <link rel="stylesheet" href="~/css/document-preview.css" asp-append-version="true" />
}
<div class="document-reader mx-auto">
    <a asp-page="./Materials" asp-route-projectId="@Model.ProjectId">← 返回项目资料</a>
    <header class="d-flex flex-wrap align-items-start justify-content-between gap-3 my-3">
        <div class="document-heading">
            <h1 class="h3 mb-2">@Model.FileName</h1>
            <p class="small text-muted mb-0">v@(Model.VersionNumber) · @(Model.IsCurrent ? "当前版本" : "历史版本") · Markdown</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="./Materials" asp-page-handler="Download" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.DocumentId" class="btn btn-outline-secondary">下载原件</a>
            @if (Model.CanEdit)
            {
                <a asp-page="./DocumentEdit" asp-route-projectId="@Model.ProjectId" asp-route-documentId="@Model.DocumentId" class="btn btn-primary">编辑正文</a>
            }
        </div>
    </header>
    @if (string.IsNullOrEmpty(Model.PreviewContent.Content))
    {
        <p class="alert alert-secondary" role="status">@Model.PreviewContent.Notice</p>
    }
    else
    {
        @if (Model.PreviewContent.IsTruncated)
        {
            <p class="alert alert-warning" role="status">预览仅显示前 10 万字符。可下载原件查看完整内容。</p>
        }
        <article class="card document-markdown p-3 p-md-4" aria-label="Markdown 正文">@DocumentMarkdownPreview.Render(Model.PreviewContent.Content)</article>
        <details class="mt-3">
            <summary>查看 Markdown 源码</summary>
            <pre class="document-source mt-2 p-3 border rounded bg-white">@Model.PreviewContent.Content</pre>
        </details>
    }
</div>
