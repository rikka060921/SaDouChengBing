@page "{meetingId:int}"
@model ToDo.Razor.Pages.MeetingMinutes.VersionListModel
@{
    ViewData["Title"] = "会议纪要历史版本记录";
}

<style>
    .btn-back {
        background-color: #6c757d;
        color: white;
    }

    .btn-diff {
        background-color: #17a2b8;
        color: white;
    }

    .btn-rollback {
        background-color: #0069d9;
        color: white;
    }

    .table-version th {
        background-color: #007bff;
        color: #fff;
    }

    /* 差异高亮样式 与弹窗内CSS统一 */
    .diff-del {
        background-color: #ffebee;
        color: #d32f2f;
        text-decoration: line-through;
    }

    .diff-add {
        background-color: #e8f5e9;
        color: #2e7d32;
    }
</style>

<div class="container mt-4">
    <div class="mb-3">
        <a asp-page="Details" asp-route-id="@Model.MeetingId" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> 返回详情页
        </a>
    </div>

    <h2 class="mb-4">会议纪要历史版本记录</h2>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMsg"]</div>
    }
    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMsg"]</div>
    }

    @if (Model.VersionList.Any())
    {
        <div class="table-responsive">
        <table class="table table-bordered table-hover table-version">
            <thead>
                <tr>
                    <th>版本号</th>
                    <th>编辑人</th>
                    <th>编辑时间</th>
                    <th>版本差异摘要</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ver in Model.VersionList)
                {
                    string editorName = ver.Editor?.RealName ?? ver.Editor?.UserName ?? "未知";
                    string diffTip = Model.VersionDiffSummaryDict.ContainsKey(ver.Id)
                    ? Model.VersionDiffSummaryDict[ver.Id]
                    : "初始版本，无变更";

                    <tr>
                        <td>@("V" + ver.VersionNumber + (ver.VersionNumber == 1 ? "(初始版本)" : ""))</td>
                        <td>@editorName</td>
                        <td>@ver.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@diffTip</td>
                        <td>
                            @if (ver.VersionNumber > 1)
                            {
                                <button class="btn btn-sm btn-diff me-1"
                                        onclick="openDiffModal(@ver.Id, @ver.VersionNumber)">
                                    查看版本差异
                                </button>
                            }

                            <form method="post" asp-page-handler="Rollback" class="d-inline" onsubmit="return confirm('确定回滚到此版本吗？回滚后会生成一条新版本记录')">
                                <input type="hidden" name="targetVersionId" value="@ver.Id" />
                                <button type="submit" class="btn btn-sm btn-rollback">回滚到此版本</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">暂无版本记录</div>
    }

    <!-- 版本差异弹窗 -->
    <partial name="_VersionDiffModal" model="Model" />
</div>

@section Scripts
{
    <script>
        let diffModal = null;

        document.addEventListener('DOMContentLoaded', function () {
            const diffModalEl = document.getElementById('versionDiffModal');
            if (diffModalEl) {
                diffModal = new bootstrap.Modal(diffModalEl, {
                    backdrop: 'static',
                    keyboard: true
                });
            }

            const closeBtn = document.getElementById("closeDiffModalBtn");
            if (closeBtn) {
                closeBtn.addEventListener("click", () => {
                    diffModal?.hide();
                });
            }
        });

        async function openDiffModal(currentVerId, verNo) {
            // 初始版本禁止打开对比
            if (verNo <= 1) {
                alert("初始版本无可对比内容");
                return;
            }
            if (!diffModal) {
                alert("弹窗组件初始化失败，请刷新页面重试");
                return;
            }

            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenEl) {
                alert("缺少安全验证令牌");
                return;
            }
            const token = tokenEl.value;

            const formData = new FormData();
            formData.append("newVerId", currentVerId);

            try {
                const resp = await fetch(`?handler=LoadDiff`, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "RequestVerificationToken": token
                    }
                });

                if (!resp.ok) {
                    throw new Error(`接口请求失败，状态码：${resp.status}`);
                }

                const res = await resp.json();

                if (!res.success) {
                    alert(res.msg || "获取版本差异失败");
                    return;
                }

                // 直接赋值后端返回好的带del/ins标签的HTML，前端无需任何diff计算
                document.getElementById("aiSummaryText").innerText = res.aiSummary;
                const oldVerNum = verNo - 1;
                document.getElementById("oldVerTitle").innerText = `V${oldVerNum} 修改前（旧版本）`;
                document.getElementById("newVerTitle").innerText = `V${verNo} 修改后（当前版本）`;

                // 后端已经处理好高亮标签，直接innerHTML渲染
                document.getElementById("oldContentBox").innerHTML = res.oldDiffHtml;
                document.getElementById("newContentBox").innerHTML = res.newDiffHtml;
                document.getElementById("diffRollbackVerId").value = res.oldVersionDbId;

                diffModal.show();

            } catch (err) {
                console.error("加载版本差异异常：", err);
                alert("网络或接口异常：" + err.message);
            }
        }
    </script>
}
