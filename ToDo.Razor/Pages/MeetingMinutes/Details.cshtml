			if (matchedTaskSel) matchedTaskSel.value = this.dataset.matchedTaskId || '0';
			if (matchedTaskRow) matchedTaskRow.style.display = actionTypeSel.value === 'TaskChange' ? '' : 'none';
		}
			});
		});

		modalEl.addEventListener('hidden.bs.modal', function () {
			this.querySelector('form').reset();
		});

		modalEl.addEventListener('hidden.bs.modal', function () {
			this.querySelector('form').reset();
		});
				document.getElementById('edit_actionType')?.addEventListener('change', function () {
			const row = document.getElementById('edit_matchedTaskRow');
			if (row) row.style.display = this.value === 'TaskChange' ? '' : 'none';
			if (this.value !== 'TaskChange') {
				const sel = document.getElementById('edit_matchedTask');
				if (sel) sel.value = '0';
			}
		});

				document.querySelector('#editActionItemModal form')?.addEventListener('submit', function (e) {
			const type = document.getElementById('edit_actionType')?.value;
			const matched = document.getElementById('edit_matchedTask')?.value;
			if (type === 'TaskChange' && (!matched || matched === '0')) {
				e.preventDefault();
				alert('改为「变更」类型时，请先选择要关联的历史任务。');
				document.getElementById('edit_matchedTask')?.focus();
				return;
			}

			// 提交前记录当前滚动位置和激活的标签页，页面重载后恢复
			sessionStorage.setItem('actionItemScrollTop', String(window.scrollY || window.pageYOffset || 0));
			const activeTab = document.querySelector('#actionItemTabs .nav-link.active');
			if (activeTab) sessionStorage.setItem('actionItemActiveTab', activeTab.id);
		});
			document.addEventListener('DOMContentLoaded', function () {
			// 先恢复标签页（必须在恢复滚动前，否则高度变化会错位）
			const savedTab = sessionStorage.getItem('actionItemActiveTab');
			if (savedTab) {
				const tabBtn = document.getElementById(savedTab);
				if (tabBtn) {
					const tab = new bootstrap.Tab(tabBtn);
					tab.show();
				}
				sessionStorage.removeItem('actionItemActiveTab');
			}

			// 再恢复滚动位置
			const savedScroll = sessionStorage.getItem('actionItemScrollTop');
			if (savedScroll !== null) {
				sessionStorage.removeItem('actionItemScrollTop');
				const top = parseInt(savedScroll, 10) || 0;
				// 用 requestAnimationFrame 确保标签页切换/布局完成后再滚
				requestAnimationFrame(() => {
					window.scrollTo({ top: top, behavior: 'auto' });
				});
			}
		});

		// ====================== 获取防伪令牌 ======================
		function getRequestVerificationToken() {
			const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
			if (!tokenInput) {
				console.error('未找到防伪令牌元素');
				return null;
			}
			return tokenInput.value;
		}

		// ====================== 通用AJAX请求函数 ======================
		async function postJsonRequest(url, formData) {
			const token = getRequestVerificationToken();
			if (!token) {
				return { success: false, msg: '防伪令牌缺失，请刷新页面重试' };
			}

			try {
				const response = await fetch(url, {
					method: 'POST',
					headers: { 'RequestVerificationToken': token },
					body: formData
				});

				if (!response.ok) {
					const errorText = await response.text();
					console.error('服务器返回错误状态:', response.status, errorText);
					try {
						return JSON.parse(errorText);
					} catch {
						return { success: false, msg: `服务器错误 (${response.status})，请联系管理员` };
					}
				}

				const rawText = await response.text();
				if (!rawText || rawText.trim() === '') {
					return { success: false, msg: '服务器返回空响应' };
				}

				try {
					return JSON.parse(rawText);
				} catch (parseError) {
					console.error('JSON解析失败，原始内容:', rawText);
					if (rawText.trim().startsWith('<!DOCTYPE') || rawText.trim().startsWith('<html')) {
						return { success: false, msg: '服务器返回了HTML页面而不是JSON，请检查路由配置' };
					}
					return { success: false, msg: `服务器返回了无效的JSON格式: ${rawText.substring(0, 100)}...` };
				}
			} catch (error) {
				console.error('请求异常:', error);
				return { success: false, msg: `网络请求失败: ${error.message}` };
			}
		}

		// ====================== 删除按钮 ======================
		document.querySelectorAll('.delete-action-btn').forEach(btn => {
			btn.addEventListener('click', async function () {
				const itemId = this.dataset.itemId;
				const meetingId = this.dataset.meetingId;
				const trEl = document.querySelector(`tr[data-action-item-id="${itemId}"]`);

				if (!confirm('确定删除该待确认任务？已同步生成正式任务的条目无法删除！')) return;

				this.disabled = true;
				const originalHtml = this.innerHTML;
				this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 删除中';

				try {
					const formData = new FormData();
					formData.append('itemId', itemId);
					formData.append('meetingId', meetingId);

					const url = window.location.pathname + '?handler=DeleteActionItem';
					const result = await postJsonRequest(url, formData);

					if (result.success) {
						alert(result.msg || '删除成功');
						if (trEl) {
							trEl.remove();
							renumberRows();
						}
						const remainingRows = document.querySelectorAll('#actionItemsBody tr');
						if (remainingRows.length === 0) {
							location.reload();
						}
					} else {
						alert(result.msg || '删除失败，请重试');
					}
				} catch (error) {
					console.error('删除请求异常:', error);
					alert('操作异常，请查看控制台错误信息');
				} finally {
					this.disabled = false;
					this.innerHTML = originalHtml;
				}
			});
		});

		// ====================== 行内下拉/输入框自动保存 ======================
		const currentMeetingId = @Model.MeetingMinutes.Id;

		async function saveRowField(itemId, fieldName, value) {
			try {
				const formData = new FormData();
				formData.append('itemId', itemId);
				formData.append('meetingId', currentMeetingId);
				formData.append(fieldName, value ?? '');

				const url = window.location.pathname + '?handler=UpdateActionItemField';
				const result = await postJsonRequest(url, formData);

				if (!result.success) {
					alert(`保存失败: ${result.msg || '未知错误'}`);
					return false;
				}
				return true;
			} catch (error) {
				console.error('行内修改保存异常:', error);
				alert('保存请求异常，请查看控制台');
				return false;
			}
		}

		// 责任人
		document.querySelectorAll('.row-assignee-select').forEach(s => {
			s.addEventListener('change', function () {
				saveRowField(this.dataset.itemId, 'assigneeId', this.value);
			});
		});

		// 来源决策
		function syncSelectTitle(s) {
			const opt = s.options[s.selectedIndex];
			s.title = opt ? opt.text : '';
		}
		document.querySelectorAll('.row-source-decision-select').forEach(s => {
			syncSelectTitle(s);
			s.addEventListener('change', function () {
				const val = this.value === '0' ? null : parseInt(this.value, 10);
				saveRowField(this.dataset.itemId, 'sourceDecisionIndex', val);
				syncSelectTitle(this);
			});
		});

		// 关联会前事项
		document.querySelectorAll('.row-prep-draft-select').forEach(s => {
			syncSelectTitle(s);
			s.addEventListener('change', function () {
				const val = this.value === '0' ? null : parseInt(this.value, 10);
				saveRowField(this.dataset.itemId, 'prepDraftTaskId', val);
				syncSelectTitle(this);
				// 同步更新内存中的 link 数据，让未关联事项卡片能重新计算
				const itemId = parseInt(this.dataset.itemId, 10);
				if (window.actionItemDraftLinks) {
					const link = window.actionItemDraftLinks.find(l => l.itemId === itemId);
					if (link) link.prepDraftTaskId = val;
				}
				if (typeof updateUndiscussedDraftCard === 'function') updateUndiscussedDraftCard();
			});
		});

		// 分组可选；无分组也正常提交，由服务端校验非空分组的项目归属。
		document.querySelectorAll('.row-group-select').forEach(s => {
			s.addEventListener('change', async function () {
				const itemId = this.dataset.itemId;
				const value = (this.value || '').trim();

				this.classList.remove('is-invalid');
				const ok = await saveRowField(itemId, 'groupName', value);
				if (!ok) {
					this.classList.add('is-invalid');
				}
			});

		});



		function updateUndiscussedDraftCard() {
			const body = document.getElementById('undiscussedDraftBody');
			const countEl = document.getElementById('undiscussedCount');
			const card = document.getElementById('unlinkedPrepCard');
			if (!body || !countEl || !card) return;
			if (!window.prepDraftTasks || window.prepDraftTasks.length === 0) return;

			// 从页面上所有下拉框的当前值动态收集已关联的 prepDraftTaskId
			const linkedIds = new Set();
			document.querySelectorAll('.row-prep-draft-select').forEach(s => {
				const v = parseInt(s.value, 10);
				if (v && v > 0) linkedIds.add(v);
			});

			const unlinked = window.prepDraftTasks.filter(t => !linkedIds.has(t.id));
			countEl.textContent = unlinked.length;

			if (unlinked.length === 0) {
				card.classList.add('d-none');
				return;
			}
			card.classList.remove('d-none');

			body.innerHTML = '<ul class="list-group list-group-flush small">' +
				unlinked.map(t => {
					const badge = t.isManual
						? '<span class="badge bg-secondary me-1">手工</span>'
						: '<span class="badge bg-primary me-1">勾选</span>';
					return `<li class="list-group-item d-flex justify-content-between align-items-center py-1"><span>${badge}${escapeHtml(t.title)}</span></li>`;
				}).join('') +
			'</ul>';
		}


		document.querySelectorAll('.source-decision-link').forEach(btn => {
			btn.addEventListener('click', function() {
				jumpToDecisionRow(parseInt(this.dataset.decisionIndex));
			});
		});
	</script>
}
