</div>

@section Scripts {
	<script>
		function escapeHtml(value) {
			return String(value ?? '').replace(/[&<>"']/g, character => ({
				'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
			})[character]);
		}

		// ===== 行动项所属项目下拉框 =====
		document.querySelectorAll('.row-project-select').forEach(s => {
			s.addEventListener('change', async function () {
				const itemId = parseInt(this.dataset.itemId);
				const newProjectId = parseInt(this.value);
				const prevValue = this.dataset.prevValue || this.value;

				this.disabled = true;
				try {
					const formData = new FormData();
					formData.append('itemId', itemId);
					formData.append('meetingId', currentMeetingId);
					formData.append('newProjectId', newProjectId);

					const url = window.location.pathname + '?handler=UpdateActionItemProject';
					const result = await postJsonRequest(url, formData);

					if (!result.success) {
						alert('保存失败：' + (result.msg || '未知错误'));
						this.value = prevValue;
						this.disabled = false;
						return;
					}

					if (result.groupCleared) alert(result.msg);
					location.reload();
				} catch (e) {
					alert('保存异常：' + e.message);
					this.value = prevValue;
					this.disabled = false;
				}
			});
			s.dataset.prevValue = s.value;
		});

		// ====================== 决策原话跳转功能 ======================
		let currentHighlight = null;
		let allHighlights = [];
		let currentHighlightTranscript = null;

		function normalizeText(text) {
			return String(text || '')
				.replace(/[\s，。、；：“”‘’（）【】《》！？,.;:\(\)\[\]!?'"`]/g, '')
				.toLowerCase();
		}

		const IGNORE_CHAR_RE = /[\s，。、；：“”‘’（）【】《》！？,.;:\(\)\[\]!?'"`]/;

		function buildElementTextIndex(element, normalized) {
			const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null);
			const index = { text: '', map: [] };
			let node;
			while ((node = walker.nextNode())) {
				const value = node.textContent || '';
				for (let offset = 0; offset < value.length; offset++) {
					const character = value[offset];
					if (normalized && IGNORE_CHAR_RE.test(character)) continue;
					index.text += normalized ? character.toLowerCase() : character;
					index.map.push({ node, offset });
				}
			}
			return index;
		}

		function highlightMappedText(indexMap, startIndex, matchLength, silent) {
			if (startIndex < 0 || matchLength <= 0 || !indexMap.length) return false;
			const selected = indexMap.slice(startIndex, startIndex + matchLength);
			if (!selected.length) return false;

			const segments = new Map();
			selected.forEach(entry => {
				const segment = segments.get(entry.node);
				if (segment) {
					segment.end = entry.offset + 1;
				} else {
					segments.set(entry.node, { node: entry.node, start: entry.offset, end: entry.offset + 1 });
				}
			});

			const created = [];
			Array.from(segments.values()).reverse().forEach(segment => {
				if (!segment.node.parentNode) return;
				const range = document.createRange();
				range.setStart(segment.node, segment.start);
				range.setEnd(segment.node, segment.end);
				const span = document.createElement('span');
				span.className = 'meeting-quote-highlight';
				span.style.backgroundColor = '#ffe066';
				span.style.padding = '2px 4px';
				span.style.borderRadius = '4px';
				span.style.boxShadow = '0 0 0 2px #ffa500';
				range.surroundContents(span);
				created.unshift(span);
			});

			if (!created.length) return false;
			currentHighlight = created[0];
			allHighlights.push(...created);
			if (!silent) {
				created[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
			return true;
		}

		function findAndHighlightInElement(element, searchText, isFuzzy, silent) {
			const source = buildElementTextIndex(element, isFuzzy);
			const target = isFuzzy ? normalizeText(searchText) : searchText;
			if (!target) return false;

			let startIndex = source.text.indexOf(target);
			let matchLength = target.length;
			if (startIndex === -1 && isFuzzy && target.length > 10) {
				const coreStart = Math.floor(target.length * 0.2);
				const coreEnd = Math.ceil(target.length * 0.8);
				const core = target.substring(coreStart, coreEnd);
				if (core.length > 5) {
					startIndex = source.text.indexOf(core);
					matchLength = core.length;
				}
			}

			return highlightMappedText(source.map, startIndex, matchLength, silent);
		}

		window.jumpToDecisionQuotes = function(decisionIndex) {
			const doHighlight = function() {
				if (!window.decisionQuoteMap) {
					alert('页面引用数据未加载（decisionQuoteMap 缺失），请刷新页面重试');
					return;
				}
				const entry = (window.decisionQuoteMap || [])[decisionIndex];
				const quotes = entry ? (entry.quotes || []) : [];
				const keyQuote = entry ? (entry.key || '').trim() : '';
				if (!quotes.length && !keyQuote) {
					alert('该决策没有会议原话标注数据，请对该会议重新执行 AI 解析生成完整讨论标注');
					return;
				}

				clearHighlight();

				const cleanQuotes = quotes
					.map(q => (q || '').replace(/^「|」$/g, '').trim())
					.filter(q => q.length > 0);
				const keyNormalized = normalizeText(keyQuote);
				const seen = new Set();
				const highlightTargets = [];
				if (keyQuote) {
					highlightTargets.push({ text: keyQuote, isKey: true });
					seen.add(keyNormalized);
				}
				cleanQuotes.forEach(quote => {
					const normalized = normalizeText(quote);
					if (!normalized || seen.has(normalized)) return;
					if (keyNormalized && (normalized.includes(keyNormalized) || keyNormalized.includes(normalized))) return;
					seen.add(normalized);
					highlightTargets.push({ text: quote, isKey: false });
				});
				if (!highlightTargets.length) return;

				const transcriptDetails = document.getElementById('meeting-transcript-details');
				const transcriptEl = document.getElementById('meeting-transcript-content');
				const markdownEl = document.getElementById('markdown-content');
				const targets = [];
				if (transcriptEl) targets.push({ element: transcriptEl, details: transcriptDetails });
				if (markdownEl) targets.push({ element: markdownEl, details: null });

				for (const target of targets) {
					let keySpan = null;
					let firstSpan = null;
					highlightTargets.forEach(item => {
						const before = currentHighlight;
						let ok = findAndHighlightInElement(target.element, item.text, false, true);
						if (!ok) {
							ok = findAndHighlightInElement(target.element, item.text, true, true);
						}
						if (ok && currentHighlight && currentHighlight !== before) {
							if (item.isKey) {
								keySpan = currentHighlight;
							} else if (!firstSpan) {
								firstSpan = currentHighlight;
							} else {
								const pos = currentHighlight.compareDocumentPosition(firstSpan);
								if (pos & Node.DOCUMENT_POSITION_FOLLOWING) firstSpan = currentHighlight;
							}
						}
					});

					const scrollTarget = keySpan || firstSpan;
					if (scrollTarget) {
						if (target.details) target.details.open = true;
						requestAnimationFrame(() => {
							scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
						});
						return;
					}
				}

				alert('未在会议原始记录或整理内容中找到该决策的讨论内容');
			};

			// 检查会议内容 tab 是否已经是激活状态
			const contentTab = document.getElementById('mtab-content');
			if (contentTab && contentTab.classList.contains('active')) {
				doHighlight();
				return;
			}
			// 否则监听 shown.bs.tab，等 tab 渲染完成后再查找（避免 DOM 未就绪）
			try {
				if (contentTab) {
					const handler = function(e) {
						if (e.target === contentTab) {
							contentTab.removeEventListener('shown.bs.tab', handler);
							doHighlight();
						}
					};
					contentTab.addEventListener('shown.bs.tab', handler);
					const tabInstance = bootstrap.Tab.getOrCreateInstance(contentTab);
					tabInstance.show();
				} else {
					doHighlight();
				}
			} catch (e) {
				doHighlight();
			}
		};

		window.jumpToDecisionRow = function(decisionIndex) {
			if (isNaN(decisionIndex) || decisionIndex < 0) return;
			document.querySelectorAll('.decision-row-flash').forEach(el => {
				el.classList.remove('decision-row-flash');
				el.style.backgroundColor = '';
			});
			const row = document.getElementById('decision-row-' + decisionIndex);
			if (!row) {
				alert('未找到对应的会议决策，请尝试重新解析任务');
				return;
			}
			row.classList.add('decision-row-flash');
			row.style.backgroundColor = '#fff3cd';
			row.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(() => {
				row.style.backgroundColor = '';
				row.classList.remove('decision-row-flash');
			}, 3000);
		};

		function clearHighlight() {
			const parentsToNormalize = new Set();
			allHighlights.forEach(span => {
				if (span && span.parentNode) {
					const parent = span.parentNode;
					parentsToNormalize.add(parent);
					while (span.firstChild) parent.insertBefore(span.firstChild, span);
					span.remove();
				}
			});
			parentsToNormalize.forEach(parent => parent.normalize());
			allHighlights = [];
			currentHighlight = null;

			if (currentHighlightTranscript) {
				const originalBg = currentHighlightTranscript.dataset.originalBg || '';
				currentHighlightTranscript.style.backgroundColor = originalBg;
				currentHighlightTranscript.style.border = '';
				currentHighlightTranscript.style.padding = '';

				const marker = document.getElementById('transcript-highlight-marker');
				if (marker) marker.remove();

				currentHighlightTranscript = null;
			}
		}

		function clearAllHighlights() {
			clearHighlight();
		}

		// ====================== AI解析绑定 ======================
		AiGeneration.bindForm(
