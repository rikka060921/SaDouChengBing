				modal.show();
						const actionTypeSel = document.getElementById('edit_actionType');
		const matchedTaskSel = document.getElementById('edit_matchedTask');
		const matchedTaskRow = document.getElementById('edit_matchedTaskRow');
		if (actionTypeSel) {
