@page
@model ToDo.Razor.Pages.MeetingMinutes.IndexModel
@using ToDo.Entities;
@{
    ViewData["Title"] = "会议纪要列表";
    var maxDate = AppTime.Today.ToString("yyyy-MM-dd");
}
<style>
    .ai-result {
        background-color: white;
        border-radius: 0.3rem;
        padding: 1rem;
        margin-top: 1rem;
        border: 1px solid #ced4da;
        min-height: 100px;
        white-space: pre-wrap;
    }
</style>

<div class="container mt-4">
    @if (Model.FilterProjectId.HasValue && Model.FilterProjectId.Value > 0)
    {
        ViewData["ProjectId"] = Model.FilterProjectId.Value;
        ViewData["ProjectSection"] = "minutes";
        <partial name="_ProjectNav" view-data="ViewData" />
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="page-heading">会议纪要</h1><div class="page-subtitle">从会议记录到行动项，再到持续督办。</div></div>
        <div class="d-flex gap-2"><a asp-page="Supervision" asp-route-projectId="@Model.FilterProjectId" class="btn btn-outline-secondary"><i class="bi bi-radar"></i> 督办中心</a>
        @if (Model.CanCreate)
        {
            <a asp-page="Create" asp-route-projectId="@Model.FilterProjectId" class="btn btn-primary">
                <i class="fas fa-plus"></i> 新建会议纪要
            </a>
        }</div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null || !string.IsNullOrWhiteSpace(Model.LoadError))
    {
        <div class="alert alert-danger">@(TempData["ErrorMessage"] ?? Model.LoadError)</div>
    }

    <div class="filter-panel mb-4">
        <form method="get" id="meetingFilterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">所属项目</label>
                    <select asp-for="FilterProjectId" asp-items="Model.Projects.Select(p => new SelectListItem(p.Name, p.Id.ToString()))"
                            class="form-select">
                        <option value="">全部项目</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">会议标题</label>
                    <input asp-for="FilterTitle" type="search" class="form-control" placeholder="搜索会议标题">
                </div>
                <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">筛选</button></div>
                <div class="col-md-2 d-grid"><a asp-page="Index" class="btn btn-light">重置</a></div>
            </div>
            <details class="filter-advanced">
                <summary>更多筛选</summary>
                <div class="row g-3 mt-1">
                    <div class="col-md-3">
                        <label class="form-label">创建人</label>
                        <input asp-for="FilterCreator" class="form-control" placeholder="搜索创建人">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">内容关键词</label>
                        <input asp-for="FilterKeyword" class="form-control" placeholder="搜索纪要内容">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">开始日期</label>
                        <input asp-for="FilterStartDate" type="date" class="form-control" max="@maxDate">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">结束日期</label>
                        <input asp-for="FilterEndDate" type="date" class="form-control" max="@maxDate">
                    </div>
                </div>
            </details>
            <input type="hidden" asp-for="CurrentPage" value="1" />
        </form>
    </div>

    <!-- ========== 新增：AI会议纪要处理区域 ========== -->
    <details class="advanced-settings mb-4">
        <summary>AI 辅助处理</summary>
        <div class="pt-2">
        <div class="small text-muted mb-3">对已有纪要进行总结、提取行动项或优化表达。</div>
        <form method="post" asp-page-handler="ProcessWithAI">
            <div class="row g-3 align-items-start">
                <!-- 改为 start 确保顶部对齐 -->
                <!-- 选择会议纪要 -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold d-block mb-1">选择会议纪要</label>
                    <div class="d-flex align-items-center" style="height: 38px;">
                        <!-- 固定高度容器 -->
                        <select asp-for="AiProcessId" class="form-select" required style="height: 100%;">
                            <option value="">-- 请选择要处理的纪要 --</option>
                            @foreach (var item in Model.MeetingMinutesList.Where(m => Model.CanEditDictionary.TryGetValue(m.Id, out bool canEdit) && canEdit))
                            {
                                <option value="@item.Id">@item.MeetingTitle</option>
                            }
                        </select>
                    </div>
                    <div class="form-text text-muted mt-1">仅显示您有权编辑的会议纪要</div>
                </div>

                <!-- 选择处理类型 -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold d-block mb-1">AI处理类型</label>
                    <div class="d-flex align-items-center" style="height: 38px;">
                        <!-- 固定高度容器 -->
                        <select asp-for="AiProcessType" class="form-select" required style="height: 100%;">
                            <option value="">-- 选择处理方式 --</option>
                            <option value="summary">AI总结（提取核心内容）</option>
                            <option value="todo">提取待办事项（结构化）</option>
                            <option value="optimize">优化内容（提升可读性）</option>
                        </select>
                    </div>
                </div>

                <!-- 处理按钮 -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold d-block mb-1" style="visibility: hidden;">按钮</label>
                    <div style="height: 38px;">
                        <!-- 固定高度容器 -->
                        <button type="submit" class="btn btn-primary w-100 h-100">
                            <i class="bi bi-cog"></i> 开始处理
                        </button>
                    </div>
                </div>
            </div>
        </form>
        <!-- AI处理结果展示 -->
        @if (!string.IsNullOrEmpty(Model.AiProcessResult))
        {
            <div class="mt-4">
                <h5 class="text-success">✅ AI处理完成（@Model.SelectedMeetingMinute?.MeetingTitle）</h5>
                <div class="ai-result">
                    @Model.AiProcessResult
                </div>
                <!-- 可选：一键替换原纪要内容按钮 -->
                @if (Model.CanEditDictionary.TryGetValue(Model.AiProcessId ?? 0, out bool canEdit) && canEdit)
                {
                    <form method="post" asp-page-handler="ApplyAiResult" class="mt-3"
                          onsubmit="return confirm('确认用 AI 处理后的内容替换原会议纪要吗？系统会保留历史版本。');">
                        <input type="hidden" name="id" value="@Model.AiProcessId" />
                        <textarea name="aiContent" class="d-none">@Model.AiProcessResult</textarea>
                        <button type="submit" class="btn btn-outline-success">一键替换原纪要内容</button>
                    </form>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.AiProcessError))
        {
            <div class="alert alert-danger mt-4">
                ❌ @Model.AiProcessError
            </div>
        }
        </div>
    </details>

    <!-- 会议纪要表格（原有代码，无修改） -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="custom-table-header">
                <tr>
                    <th>会议标题</th>
                    <th>所属项目</th>
                    <th>会议日期</th>
                    <th>创建人</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MeetingMinutesList.Any())
                {
                    @for (int i = 0; i < Model.MeetingMinutesList.Count; i++)
                    {
                        var item = Model.MeetingMinutesList[i];
                        <tr>
                            <td>@item.MeetingTitle</td>
                            <td>@item.Project?.Name</td>
                            <td>@item.MeetingDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @{
                                    var creator = Model.Creators.FirstOrDefault(u => u.Id == item.CreatorId);
                                    @(creator?.RealName ?? creator?.UserName ?? "未知用户")
                                }
                            </td>
                            <td>
                                @{ var canDeleteMeeting = Model.CanDeleteDictionary.TryGetValue(item.Id, out var deleteAllowed) && deleteAllowed; var canEditMeeting = Model.CanEditDictionary.TryGetValue(item.Id, out var editAllowed) && editAllowed; }
                                <div class="d-flex align-items-center gap-2">
									<a asp-page="Details" asp-route-id="@item.Id" asp-route-fromProjectId="@Model.FilterProjectId" class="btn btn-sm btn-outline-primary">查看</a>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="更多操作"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @if (canEditMeeting)
                                            {
                                                <li><a asp-page="Edit" asp-route-id="@item.Id" class="dropdown-item">编辑纪要</a></li>
                                            }
                                            <li><a asp-page="VersionList" asp-route-meetingId="@item.Id" class="dropdown-item">历史版本</a></li>
                                            @if (canDeleteMeeting)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@item.Id">删除纪要</button></li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                @if (canDeleteMeeting)
                                {
                                <div class="modal fade" id="deleteModal_@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">确认删除</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                确定要删除会议纪要 <strong>@item.MeetingTitle</strong> 吗？此操作不可恢复。
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                                                    <button type="submit" class="btn btn-danger">确认删除</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="alert alert-info text-center py-5">
                                <i class="bi bi-folder-open text-muted display-4"></i>
                                <h4 class="mt-3">暂无符合条件的会议纪要</h4>
                                <p>@Html.Raw("您可以点击上方\"新建会议纪要\"按钮开始管理会议纪要。")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 分页区域（原有代码，无修改） -->
    @if (Model.TotalPages > 0)
    {
        <div class="d-flex justify-content-center mt-3">
            <nav aria-label="分页导航">
                <ul class="pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-CurrentPage="1"
                           asp-route-FilterProjectId="@Model.FilterProjectId"
                           asp-route-FilterTitle="@Model.FilterTitle"
                           asp-route-FilterCreator="@Model.FilterCreator"
                           asp-route-FilterKeyword="@Model.FilterKeyword"
                           asp-route-FilterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                           asp-route-FilterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                           aria-label="首页">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           asp-route-FilterProjectId="@Model.FilterProjectId"
                           asp-route-FilterTitle="@Model.FilterTitle"
                           asp-route-FilterCreator="@Model.FilterCreator"
                           asp-route-FilterKeyword="@Model.FilterKeyword"
                           asp-route-FilterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                           asp-route-FilterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                           aria-label="上一页">
                            <span aria-hidden="true">&lsaquo;</span>
                        </a>
                    </li>

                    <li class="page-item active">
                        <span class="page-link">
                            第 @Model.CurrentPage 页 / 共 @Model.TotalPages 页
                        </span>
                    </li>

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           asp-route-FilterProjectId="@Model.FilterProjectId"
                           asp-route-FilterTitle="@Model.FilterTitle"
                           asp-route-FilterCreator="@Model.FilterCreator"
                           asp-route-FilterKeyword="@Model.FilterKeyword"
                           asp-route-FilterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                           asp-route-FilterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                           aria-label="下一页">
                            <span aria-hidden="true">&rsaquo;</span>
                        </a>
                    </li>

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-CurrentPage="@Model.TotalPages"
                           asp-route-FilterProjectId="@Model.FilterProjectId"
                           asp-route-FilterTitle="@Model.FilterTitle"
                           asp-route-FilterCreator="@Model.FilterCreator"
                           asp-route-FilterKeyword="@Model.FilterKeyword"
                           asp-route-FilterStartDate="@Model.FilterStartDate?.ToString("yyyy-MM-dd")"
                           asp-route-FilterEndDate="@Model.FilterEndDate?.ToString("yyyy-MM-dd")"
                           aria-label="末页">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        function showPermissionError(action) {
            alert('没有权限' + action + '此会议纪要。编辑仅限创建后72小时内的创建者、项目负责人、项目管理员或系统管理员；超过72小时后任何人都不能编辑。删除仍受原有权限和时间规则限制。');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = ToDoTime.todayInBeijing();
            const startDateInput = document.getElementById('FilterStartDate');
            const endDateInput = document.getElementById('FilterEndDate');
            if (startDateInput) {
                startDateInput.max = today;
            }
            if (endDateInput) {
                endDateInput.max = today;
            }
            document.getElementById('meetingFilterForm')?.addEventListener('submit', function(e) {
                const startDate = startDateInput?.value || '';
                const endDate = endDateInput?.value || '';
                if (startDate && startDate > today) {
                    alert('开始日期不能晚于今天');
                    e.preventDefault();
                    return false;
                }
                if (endDate && endDate > today) {
                    alert('结束日期不能晚于今天');
                    e.preventDefault();
                    return false;
                }
                return true;
            });
        });
    </script>
}
