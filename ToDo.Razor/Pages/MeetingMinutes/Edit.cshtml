@page "{id:int}"
@model ToDo.Razor.Pages.MeetingMinutes.EditModel
@{
	ViewData["Title"] = "编辑会议纪要";
}

<style>
	#markdown-preview {
		font-size: 14px;
		line-height: 1.8;
		max-height: 500px;
		overflow-y: auto;
		background: #f8f9fa;
		padding: 15px;
		border-radius: 4px;
	}

		#markdown-preview p {
			margin-bottom: 6px;
		}

		#markdown-preview br {
			display: block;
			content: "";
			margin-top: 4px;
		}

	#markdown-editor {
		transition: height 0.3s ease;
	}

	.editor-toolbar .btn {
		font-size: 0.8rem;
		padding: 0.2rem 0.5rem;
	}
</style>

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1>@ViewData["Title"]</h1>
	</div>

	@if (!string.IsNullOrEmpty(Model.Error))
	{
		<div class="alert alert-danger mb-4">@Model.Error</div>
	}

	@if (Model.IsReadOnly)
	{
		<div class="alert alert-warning mb-4">
			<i class="bi bi-lock"></i> 当前会议纪要不可编辑。创建超过72小时后，包括创建者和管理员在内，任何人都无法再修改。
		</div>
	}
	else
	{
		<div class="alert alert-info mb-4">
			<i class="bi bi-info-circle"></i> 可编辑至 @Model.MeetingCreatedAt.AddHours(72).ToString("yyyy-MM-dd HH:mm")；超过该时间后任何人都无法再修改。
		</div>
	}

	<form method="post" enctype="multipart/form-data" id="meetingForm">
		<input type="hidden" asp-for="Input.Id" />
		<input type="hidden" asp-for="Input.ProjectId" />
		<input type="hidden" id="deletedAttachmentIds" name="DeletedAttachmentIds" value="" />

		<div class="mb-3">
			<label class="form-label fw-bold text-dark">项目</label>
			<input type="text" class="form-control" value="@(Model.ProjectOptions.FirstOrDefault(p => p.Value == Model.Input.ProjectId.ToString())?.Text ?? "项目数据加载异常")" readonly>
			<div class="form-text text-muted">此字段不可更改</div>
		</div>

		<div class="mb-3">
			<label asp-for="Input.MeetingTitle" class="form-label fw-bold text-dark required">会议标题 <span class="text-danger">*</span></label>
			<input asp-for="Input.MeetingTitle" class="form-control" required placeholder="请输入会议标题" disabled="@Model.IsReadOnly">
			<span asp-validation-for="Input.MeetingTitle" class="text-danger"></span>
		</div>

		<!-- Markdown编辑器和预览区（与新建页一致） -->
		<div class="mb-3">
			<div class="d-flex justify-content-between align-items-center mb-2">
				<label class="form-label fw-bold text-dark mb-0">会议内容（支持Markdown）</label>
				@if (!Model.IsReadOnly)
				{
					<div>
					</div>
				}
			</div>

			@if (!Model.IsReadOnly)
			{
				<div class="border rounded p-2 bg-light mb-2 d-flex flex-wrap gap-1 editor-toolbar">
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('**', '**')">粗体 (Ctrl+B)</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('*', '*')">斜体 (Ctrl+I)</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('# ', '')">一级标题</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('## ', '')">二级标题</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('### ', '')">三级标题</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('- ', '')">无序列表</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('1. ', '')">有序列表</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('```\n', '\n```')">代码块</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertText('[链接文本](', ')')">链接</button>
				</div>
			}

			<div class="row">
				<div class="col-md-6 mb-3">
					<div class="card h-100">
						<div class="card-header bg-light">编辑区</div>
						<div class="card-body p-0">
							<textarea asp-for="Input.MeetingContent" class="form-control border-0 rounded-0 h-100" rows="15" required placeholder="请输入会议内容" disabled="@Model.IsReadOnly" id="markdown-editor"></textarea>
						</div>
					</div>
				</div>
				<div class="col-md-6 mb-3">
					<div class="card h-100">
						<div class="card-header bg-light">预览区</div>
						<div class="card-body overflow-auto" id="markdown-preview">
							<div class="text-muted">实时预览将在这里显示...</div>
						</div>
					</div>
				</div>
			</div>
			<span asp-validation-for="Input.MeetingContent" class="text-danger"></span>
			<div class="form-text mt-1">格式提示：**粗体**、*斜体*、# 标题、- 列表项、```代码块```</div>
			<div class="form-check mt-2">
				<input asp-for="Input.IsDraft" class="form-check-input" disabled="@Model.IsReadOnly" />
				<label asp-for="Input.IsDraft" class="form-check-label">保存为草稿</label>
			</div>
		</div>

		<details class="mb-4">
			<summary class="fw-semibold">会议原始记录（可选）</summary>
			<div class="mt-3">
				<label asp-for="Input.TranscriptText" class="form-label">录音转写或未经整理的原始文本</label>
				<textarea asp-for="Input.TranscriptText" class="form-control" rows="8" placeholder="可粘贴录音转写、聊天记录或现场速记。" disabled="@Model.IsReadOnly"></textarea>
				<div class="form-text">AI提取任务时优先读取原始记录；留空时使用会议内容。</div>
			</div>
		</details>

		<!-- 附件管理 -->
		<div class="mb-3">
			<label class="form-label fw-bold text-dark">附件（可选）</label>
			<input type="file" name="NewAttachments" multiple class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.txt" id="attachmentInput" disabled="@Model.IsReadOnly">
			<div class="form-text mt-1">支持格式：pdf、doc、docx、xls、xlsx、ppt、pptx、jpg、png、txt，单个文件≤10MB，单次上传不超过5个文件</div>

			@if (Model.ExistingAttachments != null && Model.ExistingAttachments.Any())
			{
				<div class="mt-3">
					<h6>已上传附件</h6>
					<div class="row mt-2" id="existingAttachments">
						@foreach (var att in Model.ExistingAttachments)
						{
							<div class="col-md-6 mb-2" data-id="@att.Id">
								<div class="card h-100">
									<div class="card-body d-flex align-items-center">
										<i class="@att.IconClass fs-3 me-3"></i>
										<div class="flex-grow-1">
											<h6 class="card-title mb-1 text-truncate">@att.FileName</h6>
											<p class="card-text small text-muted mb-0">@att.FileSizeFormatted · @att.UploadedAt.ToString("yyyy-MM-dd HH:mm")</p>
										</div>
										<a asp-page-handler="Download" asp-route-attachmentId="@att.Id" class="btn btn-outline-primary btn-sm me-2"><i class="fas fa-download"></i></a>
										<button type="button" class="btn btn-outline-danger btn-sm" onclick="removeExistingAttachment(@att.Id)" @(Model.IsReadOnly ? "disabled" : "")><i class="fas fa-trash"></i></button>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>

		<div class="row mb-4">
			<div class="col-md-6">
				<label class="form-label fw-bold text-dark">创建时间</label>
				<input type="text" class="form-control" value="@Model.MeetingCreatedAt.ToString("yyyy-MM-dd HH:mm")" readonly>
			</div>
			@if (Model.MeetingLastModifiedAt != Model.MeetingCreatedAt)
			{
				<div class="col-md-6">
					<label class="form-label fw-bold text-dark">最后修改</label>
					<input type="text" class="form-control" value="@Model.MeetingLastModifiedAt.ToString("yyyy-MM-dd HH:mm")" readonly>
				</div>
			}
		</div>

		<div class="d-flex justify-content-between">
			<a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> 返回详情</a>
			@if (!Model.IsReadOnly)
			{
				<button type="submit" class="btn btn-primary" id="saveButton"><i class="fas fa-save"></i> 保存修改</button>
			}
			else
			{
				<button type="button" class="btn btn-secondary" disabled><i class="fas fa-lock"></i> 不可修改</button>
			}
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.7/dist/purify.min.js"></script>
	<script>
		marked.setOptions({ breaks: true, gfm: true });

		const editor = document.getElementById('markdown-editor');
		const preview = document.getElementById('markdown-preview');

		function updatePreview() {
			const markdown = editor.value || '<div class="text-muted">实时预览将在这里显示...</div>';
			try { preview.innerHTML = DOMPurify.sanitize(marked.parse(markdown)); } catch (e) { preview.innerHTML = '<div class="text-danger">Markdown 解析错误</div>'; }
		}
		updatePreview();
		editor.addEventListener('input', updatePreview);

		let editorCollapsed = false;
		function toggleEditorHeight() {
			const btn = document.getElementById('toggleEditorBtn');
			editorCollapsed = !editorCollapsed;
			if (editorCollapsed) {
				editor.style.height = '80px';
				editor.style.minHeight = '80px';
				btn.innerHTML = '<i class="bi bi-chevron-down"></i> 展开';
			} else {
				editor.style.height = '';
				editor.style.minHeight = '';
				btn.innerHTML = '<i class="bi bi-chevron-up"></i> 折叠';
			}
		}

		function formatTranscript() {
			let lines = editor.value.split('\n');
			let result = [], currentSpeaker = '', currentText = '';
			for (let i = 0; i < lines.length; i++) {
				let line = lines[i].trim();
				if (!line) continue;
				let match = line.match(/^([^：:]+)[：:]\s*(.*)/);
				if (match) {
					if (currentSpeaker && currentText) { result.push(`${currentSpeaker}：${currentText}`); currentText = ''; }
					currentSpeaker = match[1];
					currentText = match[2] || '';
				} else {
					if (currentText) currentText += ' ' + line;
					else result.push(line);
				}
			}
			if (currentSpeaker && currentText) result.push(`${currentSpeaker}：${currentText}`);
			let formatted = result.join('\n').replace(/\n{3,}/g, '\n\n');
			editor.value = formatted;
			updatePreview();
			const btn = document.getElementById('formatTranscriptBtn');
			btn.innerHTML = '<i class="bi bi-check"></i> 已整理';
			btn.className = 'btn btn-sm btn-success';
			setTimeout(() => { btn.innerHTML = '<i class="bi bi-magic"></i> 整理格式'; btn.className = 'btn btn-sm btn-outline-secondary'; }, 2000);
		}

		function insertText(prefix, suffix) {
			const start = editor.selectionStart, end = editor.selectionEnd, selectedText = editor.value.substring(start, end);
			editor.value = editor.value.substring(0, start) + prefix + selectedText + suffix + editor.value.substring(end);
			const cursorPos = start + prefix.length + (selectedText ? selectedText.length : 0);
			editor.focus();
			editor.setSelectionRange(cursorPos, cursorPos);
			updatePreview();
		}

		editor.addEventListener('keydown', (e) => {
			if (e.ctrlKey && e.key === 'b') { e.preventDefault(); insertText('**', '**'); }
			if (e.ctrlKey && e.key === 'i') { e.preventDefault(); insertText('*', '*'); }
		});

		let deletedIds = [];
		function removeExistingAttachment(id) {
			if (!confirm('确定删除此附件吗？')) return;
			document.querySelector(`[data-id="${id}"]`)?.remove();
			if (!deletedIds.includes(id)) { deletedIds.push(id); document.getElementById('deletedAttachmentIds').value = deletedIds.join(','); }
		}

		document.getElementById('attachmentInput')?.addEventListener('change', function() {
			if (this.files.length > 5) { alert('最多只能上传5个附件'); this.value = ''; return; }
			for (const file of Array.from(this.files)) {
				if (file.size > 10 * 1024 * 1024) { alert(`文件「${file.name}」超过10MB限制`); this.value = ''; return; }
				const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
				if (!['.pdf','.doc','.docx','.xls','.xlsx','.ppt','.pptx','.jpg','.jpeg','.png','.txt'].includes(ext)) { alert(`文件「${file.name}」格式不支持`); this.value = ''; return; }
			}
		});

		document.getElementById('meetingForm').addEventListener('submit', function(e) {
			const title = document.querySelector('input[name="Input.MeetingTitle"]').value;
			const content = editor.value;
			if (title.trim() === '') { e.preventDefault(); alert('会议标题不能为空'); return false; }
			if (content.trim() === '') { e.preventDefault(); alert('会议内容不能为空'); return false; }
			document.getElementById('saveButton').disabled = true;
			document.getElementById('saveButton').innerHTML = '<i class="fas fa-spinner fa-spin"></i> 保存中...';
		});
	</script>
}
