
@page
@model ToDo.Razor.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "修改密码";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>修改密码</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="ChangePasswordDto.CurrentPassword" class="form-label">当前密码</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="ChangePasswordDto.CurrentPassword" type="password" class="form-control" required />
                            </div>
                            <span asp-validation-for="ChangePasswordDto.CurrentPassword" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ChangePasswordDto.NewPassword" class="form-label">新密码</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="ChangePasswordDto.NewPassword" type="password" class="form-control" required />
                            </div>
                            <span asp-validation-for="ChangePasswordDto.NewPassword" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ChangePasswordDto.ConfirmPassword" class="form-label">确认新密码</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                <input asp-for="ChangePasswordDto.ConfirmPassword" type="password" class="form-control" required />
                            </div>
                            <span asp-validation-for="ChangePasswordDto.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                            <a href="/Account/Profile" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left me-2"></i>返回
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-arrow-repeat me-2"></i>修改密码
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}