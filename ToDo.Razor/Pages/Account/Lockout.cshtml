@page
@model ToDo.Razor.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "账号暂时锁定";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <i class="bi bi-shield-lock fs-1 text-warning" aria-hidden="true"></i>
                    <h1 class="h4 mt-3">账号暂时锁定</h1>
                    <p class="text-muted mt-3 mb-4">
                        登录失败次数过多，请在 15 分钟后重试。若不是你本人操作，请联系系统管理员。
                    </p>
                    <a class="btn btn-primary" asp-page="/Account/Login">返回登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
